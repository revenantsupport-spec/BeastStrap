<?xml version="1.0"?>
<SyntaxDefinition name="Lua" extensions=".lua;.luau" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
	<Color name="Comment" foreground="#6A9955" />
	<Color name="String" foreground="#CE9178" />
	<Color name="Number" foreground="#B5CEA8" />
	<Color name="Keyword" foreground="#569CD6" fontWeight="bold" />
	<Color name="Luau" foreground="#C586C0" fontWeight="bold" />
	<Color name="Global" foreground="#4EC9B0" />

	<RuleSet ignoreCase="false">
		<Span color="Comment" multiline="true">
			<Begin>--\[\[</Begin>
			<End>\]\]</End>
		</Span>
		<Span color="Comment">
			<Begin>--</Begin>
		</Span>

		<Span color="String" multiline="true">
			<Begin>\[\[</Begin>
			<End>\]\]</End>
		</Span>
		<Span color="String">
			<Begin>"</Begin>
			<End>"</End>
			<RuleSet>
				<Span begin="\\" end="." />
			</RuleSet>
		</Span>
		<Span color="String">
			<Begin>'</Begin>
			<End>'</End>
			<RuleSet>
				<Span begin="\\" end="." />
			</RuleSet>
		</Span>

		<Keywords color="Keyword">
			<Word>and</Word>
			<Word>break</Word>
			<Word>do</Word>
			<Word>else</Word>
			<Word>elseif</Word>
			<Word>end</Word>
			<Word>false</Word>
			<Word>for</Word>
			<Word>function</Word>
			<Word>if</Word>
			<Word>in</Word>
			<Word>local</Word>
			<Word>nil</Word>
			<Word>not</Word>
			<Word>or</Word>
			<Word>repeat</Word>
			<Word>return</Word>
			<Word>then</Word>
			<Word>true</Word>
			<Word>until</Word>
			<Word>while</Word>
		</Keywords>

		<Keywords color="Luau">
			<Word>continue</Word>
			<Word>export</Word>
			<Word>type</Word>
		</Keywords>

		<Keywords color="Global">
			<Word>print</Word>
			<Word>warn</Word>
			<Word>pairs</Word>
			<Word>ipairs</Word>
			<Word>next</Word>
			<Word>select</Word>
			<Word>tostring</Word>
			<Word>tonumber</Word>
			<Word>typeof</Word>
			<Word>pcall</Word>
			<Word>xpcall</Word>
			<Word>error</Word>
			<Word>assert</Word>
			<Word>rawget</Word>
			<Word>rawset</Word>
			<Word>rawequal</Word>
			<Word>rawlen</Word>
			<Word>setmetatable</Word>
			<Word>getmetatable</Word>
			<Word>require</Word>
			<Word>self</Word>
			<Word>string</Word>
			<Word>table</Word>
			<Word>math</Word>
			<Word>coroutine</Word>
			<Word>os</Word>
			<Word>task</Word>
			<Word>bit32</Word>
			<Word>utf8</Word>
			<Word>game</Word>
			<Word>workspace</Word>
			<Word>script</Word>
			<Word>wait</Word>
			<Word>spawn</Word>
			<Word>delay</Word>
			<Word>tick</Word>
			<Word>Instance</Word>
			<Word>Vector2</Word>
			<Word>Vector3</Word>
			<Word>CFrame</Word>
			<Word>Color3</Word>
			<Word>UDim</Word>
			<Word>UDim2</Word>
			<Word>Enum</Word>
		</Keywords>

		<Rule color="Number">
			\b0[xX][0-9a-fA-F]+|\b\d+(\.\d+)?([eE][+-]?\d+)?\b
		</Rule>
	</RuleSet>
</SyntaxDefinition>
