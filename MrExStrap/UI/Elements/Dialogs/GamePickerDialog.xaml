<base:WpfUiWindow x:Class="BeastStrap.UI.Elements.Dialogs.GamePickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:base="clr-namespace:BeastStrap.UI.Elements.Base"
        xmlns:models="clr-namespace:BeastStrap.UI.ViewModels.Dialogs"
        mc:Ignorable="d"
        Title="Pick a game"
        MinWidth="0"
        MinHeight="0"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        Background="{ui:ThemeResource ApplicationBackgroundBrush}"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterScreen"
        d:DataContext="{d:DesignInstance Type=models:GamePickerViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Padding="8"
                     Title="Pick a game"
                     ShowMinimize="False" ShowMaximize="False"
                     CanMaximize="False"
                     KeyboardNavigation.TabNavigation="None"
                     Icon="pack://application:,,,/BeastStrap.ico" />

        <TextBlock Grid.Row="1" Margin="16,12,16,8" TextWrapping="Wrap" FontSize="12"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="You've got &quot;join the emptiest server&quot; turned on, but this launch didn't come from a game page so there's no game to join yet. Pick one and BeastStrap will find its least-populated server for you." />

        <ScrollViewer Grid.Row="2" MaxHeight="300" Margin="16,0,16,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Margin="0,0,0,6" FontSize="12" FontWeight="SemiBold"
                           Text="Recently played"
                           Visibility="{Binding HasRecents, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />

                <TextBlock Margin="0,4,0,8" TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="Nothing here yet — once you've played a game through BeastStrap it'll show up in this list. For now, paste a game link below."
                           Visibility="{Binding HasNoRecents, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />

                <ItemsControl ItemsSource="{Binding Recents, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,6" Padding="12,10" CornerRadius="6"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    Cursor="Hand">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="BorderBrush" Value="#3B82F6" />
                                                <Setter Property="BorderThickness" Value="2" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                  CommandParameter="{Binding PlaceId}" />
                                </Border.InputBindings>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding PlaceId}" FontFamily="Consolas" FontSize="10"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11"
                                               Text="{Binding LastPlayed}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Margin="16,12,16,4">
            <TextBlock Margin="0,0,0,6" FontSize="12" FontWeight="SemiBold" Text="Or paste a game link" />
            <ui:TextBox PlaceholderText="https://www.roblox.com/games/606849621/... or just the place id"
                        Text="{Binding PlaceIdInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <Border Grid.Row="4" Margin="0,12,0,0" Padding="14"
                Background="{ui:ThemeResource SolidBackgroundFillColorSecondaryBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button MinWidth="140" Content="Just launch Roblox"
                           Command="{Binding SkipCommand, Mode=OneTime}" />
                <ui:Button MinWidth="160" Margin="8,0,0,0" Icon="Play24" Content="Join emptiest server"
                           Appearance="Primary"
                           IsEnabled="{Binding CanConfirm, Mode=OneWay}"
                           Command="{Binding ConfirmCommand, Mode=OneTime}" />
            </StackPanel>
        </Border>
    </Grid>

    <base:WpfUiWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </base:WpfUiWindow.Resources>
</base:WpfUiWindow>
