<base:WpfUiWindow x:Class="BeastStrap.UI.Elements.Dialogs.ExecutorCheckerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:base="clr-namespace:BeastStrap.UI.Elements.Base"
        mc:Ignorable="d"
        Title="Executor checker"
        Width="820"
        Height="640"
        MinWidth="620"
        MinHeight="460"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Padding="8" Title="Executor checker" ShowMinimize="False" ShowMaximize="False"
                     CanMaximize="False" Icon="pack://application:,,,/BeastStrap.ico" />

        <Grid Grid.Row="1" Margin="16,6,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Compact header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="Executor checker" Style="{StaticResource TitleText}" />
                <TextBlock x:Name="SummaryText" Margin="0,3,0,0" FontSize="11.5" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Margin="0,1,0,0" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Text="Green outline = up to date · red = not updated · amber = issues · live from WEAO (robloxscripts.com backup)" />
            </StackPanel>

            <!-- Toolbar -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox x:Name="SearchBox" Grid.Column="0" Icon="Search32"
                            PlaceholderText="Search executors…" TextChanged="SearchBox_TextChanged" />
                <ComboBox x:Name="SortCombo" Grid.Column="1" Width="172" Margin="8,0,0,0" Padding="10,5,10,5"
                          SelectedIndex="0" SelectionChanged="SortCombo_SelectionChanged"
                          PreviewMouseWheel="ComboBox_PreviewMouseWheel">
                    <ComboBoxItem Content="Recently updated" />
                    <ComboBoxItem Content="Name (A–Z)" />
                    <ComboBoxItem Content="UNC (high → low)" />
                    <ComboBoxItem Content="Cost (low → high)" />
                </ComboBox>
                <ui:Button Grid.Column="2" x:Name="RefreshButton" Margin="8,0,0,0"
                           Icon="ArrowClockwise24" Content="Refresh" Click="RefreshButton_Click" />
            </Grid>

            <!-- Status list: one row per executor, outlined by status -->
            <Grid Grid.Row="2">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.CanContentScroll="False" ScrollViewer.PanningMode="VerticalOnly"
                              ScrollViewer.PanningDeceleration="10" Padding="0,0,4,4">
                    <ItemsControl x:Name="ExecutorList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,10" Margin="0,0,0,8" CornerRadius="8" BorderThickness="1.5"
                                        BorderBrush="{Binding StatusColor}"
                                        Background="{DynamicResource GlassFillBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Logo -->
                                        <Border Grid.Column="0" Width="46" Height="46" CornerRadius="6" Background="#0D0D0D"
                                                BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                                                VerticalAlignment="Top" HorizontalAlignment="Left">
                                            <Grid>
                                                <Image Source="{Binding Logo, Mode=OneWay}" Stretch="Uniform" Margin="5"
                                                       Visibility="{Binding HasLogo, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                                                <TextBlock Text="{Binding LetterPlaceholder}" Foreground="White" FontWeight="Bold" FontSize="18"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="{Binding NoLogo, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                                            </Grid>
                                        </Border>

                                        <!-- Main column -->
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="420" />
                                                <Border Margin="10,0,0,0" Padding="8,2" CornerRadius="10" Background="#14FFFFFF" ToolTip="{Binding StatusTooltip}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                                 Fill="{Binding StatusColor}" Margin="0,0,5,0" />
                                                        <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{Binding StatusColor}"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>

                                            <!-- Version + cost -->
                                            <TextBlock Margin="0,5,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Text="{Binding VersionLine}" />

                                            <!-- Supported Roblox build -->
                                            <TextBlock Margin="0,2,0,0" FontSize="11.5" Style="{StaticResource BrandMono}"
                                                       Text="{Binding RbxLine}" TextTrimming="CharacterEllipsis" ToolTip="{Binding RbxLine}" />

                                            <!-- Feature chips -->
                                            <ItemsControl Margin="0,5,0,0" ItemsSource="{Binding Features, Mode=OneWay}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,0,6,4" Padding="7,2" CornerRadius="9" Background="#14FFFFFF"
                                                                ToolTip="{Binding Tooltip}">
                                                            <TextBlock Text="{Binding Text}" FontSize="10.5" Foreground="{Binding Color}" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Detection / banwave notes -->
                                            <TextBlock Margin="0,5,0,0" FontSize="11" Foreground="#F59E0B" TextWrapping="Wrap"
                                                       Text="{Binding DetectionNote}"
                                                       Visibility="{Binding HasDetectionNote, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                                            <TextBlock Margin="0,2,0,0" FontSize="11" FontWeight="SemiBold" Foreground="#EF4444" TextWrapping="Wrap"
                                                       Text="{Binding BanwaveNote}"
                                                       Visibility="{Binding HasBanwaveNote, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />

                                            <!-- Tracked line -->
                                            <TextBlock Margin="0,4,0,0" FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="{Binding TrackedColor}" Text="{Binding TrackedLine}"
                                                       Visibility="{Binding IsTracked, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                                        </StackPanel>

                                        <!-- Buttons column -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="12,0,0,0">
                                            <ui:Button MinWidth="88" Padding="8,4" Icon="Open24" Content="Website"
                                                       Click="WebsiteButton_Click" />
                                            <ui:Button Margin="0,6,0,0" MinWidth="88" Padding="8,4" Icon="People24" Content="Discord"
                                                       Click="DiscordButton_Click"
                                                       Visibility="{Binding HasDiscord, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                                            <ui:Button Margin="0,6,0,0" MinWidth="88" Padding="8,4" Icon="Money24" Content="Purchase"
                                                       Click="PurchaseButton_Click"
                                                       Visibility="{Binding HasPurchase, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border x:Name="EmptyOverlay" CornerRadius="6" Background="{DynamicResource GlassFillBrush}"
                        BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                        Visibility="Collapsed" Padding="20">
                    <TextBlock x:Name="EmptyText" TextWrapping="Wrap" TextAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Margin="0,10,0,0" Padding="14,10"
                Background="{DynamicResource GlassFillBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="11"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <ui:Button MinWidth="100" Content="Close" Click="CloseButton_Click" IsCancel="True" />
            </StackPanel>
        </Border>
    </Grid>

    <base:WpfUiWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </base:WpfUiWindow.Resources>
</base:WpfUiWindow>