<base:WpfUiWindow x:Class="BeastStrap.UI.Elements.Dialogs.ExecutorCheckerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:base="clr-namespace:BeastStrap.UI.Elements.Base"
        mc:Ignorable="d"
        Title="Executor checker"
        Width="960"
        Height="720"
        MinWidth="720"
        MinHeight="520"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Padding="8" Title="Executor checker" ShowMinimize="False" ShowMaximize="False"
                     CanMaximize="False" Icon="pack://application:,,,/BeastStrap.ico" />

        <Grid Grid.Row="1" Margin="20,6,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Hero header — echoes whatexpsare.online's wordmark -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,2,0,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="What " Style="{StaticResource DisplayText}" />
                    <TextBlock Text="Exps" Style="{StaticResource DisplayText}" Foreground="{DynamicResource BrandCyanBrush}" />
                    <TextBlock Text=" Are." Style="{StaticResource DisplayText}" />
                    <TextBlock Text="Online" Style="{StaticResource DisplayText}" Foreground="{DynamicResource BrandGradientTriBrush}" />
                </StackPanel>
                <TextBlock HorizontalAlignment="Center" Margin="0,4,0,0" FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="The #1 Roblox exploit status tracker · live from WEAO (robloxscripts.com backup)" />
                <Border Height="3" Width="170" CornerRadius="2" Margin="0,12,0,0" HorizontalAlignment="Center"
                        Background="{DynamicResource BrandGradientBrush}" />
            </StackPanel>

            <!-- Status stats strip -->
            <WrapPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,14">
                <Border Style="{StaticResource HomeTile}" Width="112" MinHeight="58" Margin="4">
                    <StackPanel>
                        <TextBlock Text="TOTAL" Style="{StaticResource BrandSectionHeader}" Margin="0,0,0,3" />
                        <TextBlock x:Name="StatTotal" FontSize="20" FontWeight="SemiBold" Style="{StaticResource BrandMono}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource HomeTile}" Width="112" MinHeight="58" Margin="4">
                    <StackPanel>
                        <TextBlock Text="UPDATED" Style="{StaticResource BrandSectionHeader}" Margin="0,0,0,3" Foreground="#4CAF50" />
                        <TextBlock x:Name="StatUpdated" FontSize="20" FontWeight="SemiBold" Foreground="#4CAF50" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource HomeTile}" Width="112" MinHeight="58" Margin="4">
                    <StackPanel>
                        <TextBlock Text="NOT UPDATED" Style="{StaticResource BrandSectionHeader}" Margin="0,0,0,3" Foreground="#EF4444" />
                        <TextBlock x:Name="StatNotUpdated" FontSize="20" FontWeight="SemiBold" Foreground="#EF4444" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource HomeTile}" Width="112" MinHeight="58" Margin="4">
                    <StackPanel>
                        <TextBlock Text="ISSUES" Style="{StaticResource BrandSectionHeader}" Margin="0,0,0,3" Foreground="#F59E0B" />
                        <TextBlock x:Name="StatIssues" FontSize="20" FontWeight="SemiBold" Foreground="#F59E0B" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource HomeTile}" Width="112" MinHeight="58" Margin="4">
                    <StackPanel>
                        <TextBlock Text="TRACKED" Style="{StaticResource BrandSectionHeader}" Margin="0,0,0,3" Foreground="{DynamicResource BrandPurpleBrush}" />
                        <TextBlock x:Name="StatTracked" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource BrandPurpleBrush}" />
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- Toolbar -->
            <Grid Grid.Row="2" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox x:Name="SearchBox" Grid.Column="0" Icon="Search32"
                            PlaceholderText="Search executors…" TextChanged="SearchBox_TextChanged" />
                <ComboBox x:Name="SortCombo" Grid.Column="1" Width="172" Margin="8,0,0,0" Padding="10,5,10,5"
                          SelectedIndex="0" SelectionChanged="SortCombo_SelectionChanged"
                          PreviewMouseWheel="ComboBox_PreviewMouseWheel">
                    <ComboBoxItem Content="Recently updated" />
                    <ComboBoxItem Content="Name (A–Z)" />
                    <ComboBoxItem Content="UNC (high → low)" />
                    <ComboBoxItem Content="Cost (low → high)" />
                </ComboBox>
                <ui:Button Grid.Column="2" x:Name="RefreshButton" Margin="8,0,0,0"
                           Icon="ArrowClockwise24" Content="Refresh" Click="RefreshButton_Click" />
            </Grid>

            <!-- Card grid -->
            <Grid Grid.Row="3">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.CanContentScroll="False" ScrollViewer.PanningMode="VerticalOnly"
                              ScrollViewer.PanningDeceleration="10" Padding="0,0,4,4">
                    <ItemsControl x:Name="ExecutorList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="300" Margin="6" Padding="14,12" CornerRadius="12" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource GlassFillBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource BrandCyanBrush}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <!-- Header: logo + name/status -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="52" Height="52" CornerRadius="10" Background="#0D0D0D"
                                                    BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1">
                                                <Grid>
                                                    <Image Source="{Binding Logo, Mode=OneWay}" Stretch="Uniform" Margin="5"
                                                           Visibility="{Binding HasLogo, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                                                    <TextBlock Text="{Binding LetterPlaceholder}" Foreground="White" FontWeight="Bold" FontSize="22"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Visibility="{Binding NoLogo, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
                                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                    <Border Padding="8,2" CornerRadius="10" Background="#14FFFFFF" ToolTip="{Binding StatusTooltip}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                                     Fill="{Binding StatusColor}" Margin="0,0,5,0" />
                                                            <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{Binding StatusColor}"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Margin="6,0,0,0" Padding="8,2" CornerRadius="10" Background="#14FFFFFF"
                                                            ToolTip="{Binding CostTooltip}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <ui:SymbolIcon Symbol="Money24" FontSize="12" VerticalAlignment="Center"
                                                                           Foreground="{Binding CostColor}" Margin="0,0,4,0" />
                                                            <TextBlock Text="{Binding CostDisplay}" FontSize="11" Foreground="{Binding CostColor}"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Version + supported Roblox build -->
                                        <TextBlock Margin="0,10,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Text="{Binding VersionLine}" />
                                        <TextBlock Margin="0,3,0,0" FontSize="11.5" Style="{StaticResource BrandMono}"
                                                   Text="{Binding RbxLine}" TextTrimming="CharacterEllipsis" ToolTip="{Binding RbxLine}" />

                                        <!-- Feature chips -->
                                        <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Features, Mode=OneWay}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,6,4" Padding="7,2" CornerRadius="9" Background="#14FFFFFF"
                                                            ToolTip="{Binding Tooltip}">
                                                        <TextBlock Text="{Binding Text}" FontSize="10.5" Foreground="{Binding Color}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Detection / banwave notes -->
                                        <TextBlock Margin="0,6,0,0" FontSize="11" Foreground="#F59E0B" TextWrapping="Wrap"
                                                   Text="{Binding DetectionNote}"
                                                   Visibility="{Binding HasDetectionNote, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                                        <TextBlock Margin="0,3,0,0" FontSize="11" FontWeight="SemiBold" Foreground="#EF4444" TextWrapping="Wrap"
                                                   Text="{Binding BanwaveNote}"
                                                   Visibility="{Binding HasBanwaveNote, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />

                                        <!-- Tracked line -->
                                        <TextBlock Margin="0,6,0,0" FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="{Binding TrackedColor}" Text="{Binding TrackedLine}"
                                                   Visibility="{Binding IsTracked, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />

                                        <!-- Action buttons -->
                                        <WrapPanel Margin="0,10,0,0">
                                            <ui:Button MinWidth="88" Padding="8,4" Icon="Open24" Content="Website"
                                                       Click="WebsiteButton_Click" />
                                            <ui:Button Margin="6,0,0,0" MinWidth="88" Padding="8,4" Icon="People24" Content="Discord"
                                                       Click="DiscordButton_Click"
                                                       Visibility="{Binding HasDiscord, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                                            <ui:Button Margin="6,0,0,0" MinWidth="88" Padding="8,4" Icon="Money24" Content="Purchase"
                                                       Click="PurchaseButton_Click"
                                                       Visibility="{Binding HasPurchase, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border x:Name="EmptyOverlay" CornerRadius="6" Background="{DynamicResource GlassFillBrush}"
                        BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                        Visibility="Collapsed" Padding="20">
                    <TextBlock x:Name="EmptyText" TextWrapping="Wrap" TextAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Margin="0,10,0,0" Padding="14,10"
                Background="{DynamicResource GlassFillBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="11"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <ui:Button MinWidth="100" Content="Close" Click="CloseButton_Click" IsCancel="True" />
            </StackPanel>
        </Border>
    </Grid>

    <base:WpfUiWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </base:WpfUiWindow.Resources>
</base:WpfUiWindow>
