<base:WpfUiWindow x:Class="BeastStrap.UI.Elements.Dialogs.LaunchMenuDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:BeastStrap.UI.Elements.Dialogs"
        xmlns:base="clr-namespace:BeastStrap.UI.Elements.Base"
        xmlns:controls="clr-namespace:BeastStrap.UI.Elements.Controls"
        xmlns:models="clr-namespace:BeastStrap.UI.ViewModels"
        xmlns:resources="clr-namespace:BeastStrap.Resources"
        mc:Ignorable="d"
        Title="BeastStrap"
        MinWidth="0"
        MinHeight="0"
        Width="660"
        Height="560"
        ResizeMode="NoResize"
        Background="{ui:ThemeResource ApplicationBackgroundBrush}"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Ambient aurora behind everything -->
        <controls:AmbientBackground Grid.RowSpan="2" />

        <ui:TitleBar Grid.Row="0" Grid.ColumnSpan="2" Padding="8" ShowMinimize="False" ShowMaximize="False" Title="BeastStrap" Icon="pack://application:,,,/BeastStrap.ico" CanMaximize="False" KeyboardNavigation.TabNavigation="None" />

        <!-- User wallpaper backdrop (collapsed unless the user sets one). Shares the content row
             with the body so the row gets a definite height and the image doesn't collapse. -->
        <controls:WallpaperBackground Grid.Row="1" />

        <Grid Grid.Row="1" Margin="14,6,14,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Brand header: icon + wordmark + version, channel-lock chip pinned right. -->
            <Border Grid.Row="0" Margin="4,0,4,12" Padding="14,12" CornerRadius="12"
                    Background="{DynamicResource GlassFillBrush}"
                    BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                    Effect="{DynamicResource CardShadowEffect}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Image Width="48" Height="48" Source="pack://application:,,,/Resources/BeastStrapIcon.png"
                           VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"
                           Effect="{DynamicResource BrandGlowSoft}" />

                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="BeastStrap" Style="{StaticResource TitleText}" LineHeight="26" />
                        <TextBlock Text="{Binding Version, Mode=OneTime}" Style="{StaticResource CaptionText}"
                                   FontFamily="{StaticResource BrandMonoFont}" Margin="0,2,0,0" />
                    </StackPanel>

                    <Border Grid.Column="2" VerticalAlignment="Center" Padding="10,4" CornerRadius="10"
                            Background="{Binding ChannelLockBackground, Mode=OneTime}">
                        <TextBlock Text="{Binding ChannelLockText, Mode=OneTime}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                    </Border>
                </Grid>
            </Border>

            <!-- Body: quick links on the left, launch actions on the right. -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="258" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left: community / links card -->
                <Border Grid.Column="0" Margin="0,0,12,0" Padding="10" CornerRadius="12"
                        Background="{DynamicResource GlassFillBrush}"
                        BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                        VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="COMMUNITY &amp; LINKS" Style="{StaticResource BrandSectionHeader}" Margin="6,2,0,6" />

                        <ui:CardAction Margin="0,2,0,0" TabIndex="4" Icon="QuestionCircle48"
                                       Command="{Binding LaunchAboutCommand, Mode=OneTime}">
                            <StackPanel>
                                <TextBlock FontSize="13" Text="{x:Static resources:Strings.About_Title}" />
                            </StackPanel>
                        </ui:CardAction>

                        <ui:Hyperlink Icon="PeopleCommunity28" Content="Roblox Exploit Community"
                                      NavigateUri="https://robloxscripts.com/" Margin="10,6,0,0" FontSize="13" />

                        <ui:Hyperlink Icon="PlayCircle28" Content="YouTube"
                                      NavigateUri="https://www.youtube.com/@RealMrExploit-f5h" Margin="10,4,0,0" FontSize="13" />

                        <ui:CardAction Margin="0,6,0,0" TabIndex="5" Icon="ArrowClockwise24"
                                       Command="{Binding CheckForUpdatesCommand, Mode=OneTime}">
                            <StackPanel>
                                <TextBlock FontSize="13" Text="Check for updates" />
                            </StackPanel>
                        </ui:CardAction>
                    </StackPanel>
                </Border>

                <!-- Right: launch actions -->
                <StackPanel Grid.Column="1" Margin="10,4,8,4" VerticalAlignment="Center">
                    <!-- Hero launch CTA: clean cyan->green gradient (glow removed, glassy look). -->
                    <ui:Button x:Name="LaunchButton" TabIndex="0" Appearance="Primary" Icon="Play24" FontSize="15" Height="58"
                               Margin="0,0,0,10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                               Content="{x:Static resources:Strings.LaunchMenu_LaunchRoblox}"
                               Command="{Binding LaunchRobloxCommand, Mode=OneTime}" />

                    <!-- Roblox Studio launch (wired into the existing LaunchRobloxStudioCommand). -->
                    <ui:Button TabIndex="1" Appearance="Secondary" Icon="Code24" FontSize="13" Height="42"
                               Margin="0,0,0,10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                               Content="{x:Static resources:Strings.LaunchMenu_LaunchRobloxStudio}"
                               Command="{Binding LaunchRobloxStudioCommand, Mode=OneTime}" />

                    <ui:CardAction Margin="0,4,0,0" TabIndex="2" Icon="Settings28" Command="{Binding LaunchSettingsCommand, Mode=OneTime}">
                        <StackPanel>
                            <TextBlock FontSize="14" Text="{x:Static resources:Strings.LaunchMenu_ConfigureSettings}" />
                        </StackPanel>
                    </ui:CardAction>

                    <ui:CardAction Margin="0,8,0,0" TabIndex="3" Icon="ArrowReset24" Command="{Binding ResetToStockCommand, Mode=OneTime}">
                        <StackPanel>
                            <TextBlock FontSize="14" TextWrapping="Wrap" Text="Reset to non-BeastStrap setup" />
                            <TextBlock Margin="0,2,0,0" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="Hand Roblox back to normal so you can use Volt or other non-bootstrapper tools. Re-hooks when you next launch through BeastStrap." />
                        </StackPanel>
                    </ui:CardAction>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</base:WpfUiWindow>