<base:WpfUiWindow x:Class="BeastStrap.UI.Elements.Dialogs.ScriptDetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:base="clr-namespace:BeastStrap.UI.Elements.Base"
        xmlns:models="clr-namespace:BeastStrap.UI.ViewModels.Dialogs"
        mc:Ignorable="d"
        Title="Script details"
        MinWidth="0"
        MinHeight="0"
        Width="700"
        MaxHeight="820"
        SizeToContent="Height"
        ResizeMode="NoResize"
        Background="{ui:ThemeResource ApplicationBackgroundBrush}"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterOwner"
        d:DataContext="{d:DesignInstance Type=models:ScriptDetailsViewModel}">

    <base:WpfUiWindow.Resources>

        <!-- Sections are cards rather than bare stacks: with this much varied content, a flat list
             of headings runs together and the dialog reads as a wall of text. -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <!-- BasedOn is required: without it the WPF-UI SymbolIcon template (and its icon font) is
             replaced by the default ContentControl one and every section icon renders blank. -->
        <Style x:Key="CardIcon" TargetType="ui:SymbolIcon" BasedOn="{StaticResource {x:Type ui:SymbolIcon}}">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource BrandCyanBrush}" />
        </Style>

    </base:WpfUiWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Padding="8"
                     Title="Script details"
                     ShowMinimize="False" ShowMaximize="False"
                     CanMaximize="False"
                     KeyboardNavigation.TabNavigation="None"
                     Icon="{DynamicResource BrandTitleBarIcon}" />

        <!-- Header band: the identity of the script, set apart from the detail below it. -->
        <Border Grid.Row="1" Padding="20,14,20,16"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 16:9 to match the list rows and the source art itself — see the note in
                     ScriptsPage.xaml. A square tile cropped the sides off most thumbnails. -->
                <Grid Grid.Column="0" Width="128" Height="72" Margin="0,0,16,0" VerticalAlignment="Top">
                    <Border CornerRadius="10" Background="{DynamicResource ChipCheckedBg}"
                            BorderBrush="{DynamicResource BrandAccentEdgeBrush}" BorderThickness="1"
                            Visibility="{Binding Row.PlaceholderVisibility}">
                        <TextBlock Text="{Binding PlaceholderGlyph}" FontSize="30" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    </Border>
                    <!-- ImageBrush, not an Image child: Border.ClipToBounds ignores CornerRadius. -->
                    <Border CornerRadius="10" Visibility="{Binding Row.ThumbnailVisibility}"
                            RenderOptions.BitmapScalingMode="HighQuality">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding Row.Thumbnail}" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                </Grid>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="19" FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                        <TextBlock Text="{Binding AuthorText}" FontSize="12"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding AuthorVisibility}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <ui:SymbolIcon Symbol="CheckmarkCircle16" FontSize="14" Margin="4,0,0,0"
                                       VerticalAlignment="Center"
                                       ToolTip="Verified author"
                                       Visibility="{Binding VerifiedVisibility}"
                                       Foreground="{DynamicResource BrandCyanBrush}" />

                        <Border Margin="10,0,0,0" Padding="8,2" CornerRadius="4" VerticalAlignment="Center"
                                Visibility="{Binding AccessVisibility}"
                                Background="{DynamicResource ChipCheckedBg}"
                                BorderBrush="{DynamicResource BrandAccentEdgeBrush}" BorderThickness="1">
                            <TextBlock Text="{Binding AccessLabel}" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        </Border>
                    </StackPanel>

                    <TextBlock Text="{Binding Meta}" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Key system notice -->
        <Border Grid.Row="2" Margin="20,14,20,0" Padding="14,10" CornerRadius="8"
                Visibility="{Binding KeyVisibility}"
                Background="{DynamicResource ChipCheckedBg}"
                BorderBrush="{DynamicResource BrandAccentEdgeBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:SymbolIcon Grid.Column="0" Symbol="Key24" FontSize="17" Margin="0,0,11,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource BrandCyanBrush}" />

                <!-- Plain TextBlock, not ui:InfoBar — InfoBar's message doesn't wrap. -->
                <TextBlock Grid.Column="1" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="This one's behind a key system. You'll need to grab a key from the author's link before it will run." />

                <ui:Button Grid.Column="2" Margin="12,0,0,0" Padding="12,5" Content="Get key"
                           Visibility="{Binding KeyLinkVisibility}"
                           Command="{Binding GetKeyCommand}" />
            </Grid>
        </Border>

        <!-- Body -->
        <ScrollViewer Grid.Row="3" Margin="20,14,20,0" MaxHeight="420"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,4,0">

                <!-- Features: the reason this dialog exists. A two-column checklist, because a row
                     of pills makes 20 features unreadable and hides how many there are. -->
                <Border Style="{StaticResource Card}" Visibility="{Binding FeaturesVisibility}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <ui:SymbolIcon Symbol="Sparkle24" Style="{StaticResource CardIcon}" />
                            <TextBlock Text="Features" Style="{StaticResource CardTitle}" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding Features}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,14,8">
                                        <ui:SymbolIcon Symbol="Checkmark24" FontSize="13" Margin="0,1,9,0"
                                                       VerticalAlignment="Top"
                                                       Foreground="{DynamicResource BrandCyanBrush}" />
                                        <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Supported games, each opening the game in the browser -->
                <Border Style="{StaticResource Card}" Visibility="{Binding GamesVisibility}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                            <ui:SymbolIcon Symbol="Games24" Style="{StaticResource CardIcon}" />
                            <TextBlock Text="{Binding GamesHeader}" Style="{StaticResource CardTitle}" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding SupportedGames}" Margin="0,10,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="0,0,18,7" FontSize="12">
                                        <Hyperlink Command="{Binding OpenCommand}"
                                                   ToolTip="{Binding Url}"
                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                   TextDecorations="{x:Null}">
                                            <Run Text="{Binding Name, Mode=OneWay}" />
                                        </Hyperlink>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Description -->
                <Border Style="{StaticResource Card}" Visibility="{Binding DescriptionVisibility}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <ui:SymbolIcon Symbol="TextDescription24" Style="{StaticResource CardIcon}" />
                            <TextBlock Text="About" Style="{StaticResource CardTitle}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" FontSize="12" TextWrapping="Wrap"
                                   LineHeight="18"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Alternative builds, each with its own loadstring -->
                <Border Style="{StaticResource Card}" Visibility="{Binding VariantsVisibility}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <ui:SymbolIcon Symbol="Layer24" Style="{StaticResource CardIcon}" />
                            <TextBlock Text="{Binding VariantsHeader}" Style="{StaticResource CardTitle}" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding Variants}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,6" Padding="12,9" CornerRadius="6"
                                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                            BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                <TextBlock Text="{Binding Description}" FontSize="11" Margin="0,3,0,0"
                                                           TextWrapping="Wrap"
                                                           Visibility="{Binding DescriptionVisibility}"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            </StackPanel>

                                            <ui:Button Grid.Column="1" Padding="11,5" Icon="Copy24" Content="Copy"
                                                       VerticalAlignment="Center"
                                                       Command="{Binding CopyCommand}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Status -->
        <Grid Grid.Row="4" Margin="20,10,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:ProgressRing Grid.Column="0" Width="14" Height="14" Margin="0,0,8,0" IsIndeterminate="True"
                             Visibility="{Binding Loading, Converter={StaticResource BoolToVis}}" />
            <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="11" TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        </Grid>

        <!-- Actions -->
        <Border Grid.Row="5" Margin="0,14,0,0" Padding="20,14"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Padding="9,6" ToolTip="{Binding Row.FavouriteTooltip}"
                           Icon="{Binding Row.FavouriteSymbol}"
                           Command="{Binding Row.ToggleFavouriteCommand}" />
                <ui:Button Margin="8,0,0,0" Padding="12,6" Icon="Open24" Content="Open page"
                           Command="{Binding OpenPageCommand}" />
                <ui:Button Margin="8,0,0,0" Padding="14,6" Icon="Copy24" Content="Copy loadstring"
                           Appearance="Primary"
                           Command="{Binding CopyCommand}" />
                <ui:Button Margin="8,0,0,0" Padding="14,6" Content="Close" IsCancel="True"
                           Command="{Binding CloseCommand}" />
            </StackPanel>
        </Border>
    </Grid>
</base:WpfUiWindow>
