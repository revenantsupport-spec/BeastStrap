<base:WpfUiWindow x:Class="BeastStrap.UI.Elements.Dialogs.VersionHistoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:base="clr-namespace:BeastStrap.UI.Elements.Base"
        mc:Ignorable="d"
        Title="Version history"
        Width="760"
        Height="620"
        MinWidth="560"
        MinHeight="420"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Padding="8" Title="Version history" ShowMinimize="False" ShowMaximize="False"
                     CanMaximize="False" Icon="pack://application:,,,/BeastStrap.ico" />

        <Grid Grid.Row="1" Margin="16,6,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Compact header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="Version history" Style="{StaticResource TitleText}" />
                <TextBlock x:Name="SummaryText" Margin="0,3,0,0" FontSize="11.5" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Toolbar -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="11.5" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Text="Release notes for each BeastStrap build, live from GitHub." />
                <ui:Button Grid.Column="1" x:Name="RefreshButton" Margin="8,0,0,0"
                           Icon="ArrowClockwise24" Content="Refresh" Click="RefreshButton_Click" />
            </Grid>

            <!-- Release list: one row per published version -->
            <Grid Grid.Row="2">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.CanContentScroll="False" ScrollViewer.PanningMode="VerticalOnly"
                              ScrollViewer.PanningDeceleration="10" Padding="0,0,4,4">
                    <ItemsControl x:Name="ReleaseList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,10" Margin="0,0,0,8" CornerRadius="8" BorderThickness="1"
                                        BorderBrush="{DynamicResource GlassBorderBrush}"
                                        Background="{DynamicResource GlassFillBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Version}" FontWeight="SemiBold" FontSize="14"
                                                           Style="{StaticResource BrandMono}" VerticalAlignment="Center" />
                                                <Border Margin="10,0,0,0" Padding="8,2" CornerRadius="10" Background="#14FFFFFF">
                                                    <TextBlock Text="{Binding PublishedText}" FontSize="11"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Margin="0,5,0,0" FontSize="12" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Text="{Binding BodyText}" />
                                        </StackPanel>

                                        <ui:Button Grid.Column="1" VerticalAlignment="Top" MinWidth="88" Padding="8,4"
                                                   Icon="Open24" Content="Open" Click="OpenButton_Click" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border x:Name="EmptyOverlay" CornerRadius="6" Background="{DynamicResource GlassFillBrush}"
                        BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                        Visibility="Collapsed" Padding="20">
                    <TextBlock x:Name="EmptyText" TextWrapping="Wrap" TextAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Margin="0,10,0,0" Padding="14,10"
                Background="{DynamicResource GlassFillBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="11"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <ui:Button MinWidth="100" Content="Close" Click="CloseButton_Click" IsCancel="True" />
            </StackPanel>
        </Border>
    </Grid>
</base:WpfUiWindow>