<UserControl x:Class="BeastStrap.UI.Elements.Controls.PromoBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:BeastStrap.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="760">
    <!--
        Rotating promo banner. Slots live in the code-behind; this is just the shell.
        Replaces the old single rsware.store banner removed in v420.41.

        ⚠️ Everything is STATIC — text, icons, links, all compiled in. Nothing is fetched at runtime.
        That is deliberate, not incidental: the app promises in its own settings UI and in the README
        that nothing is ever sent anywhere, and a remotely-loaded banner would quietly send a request
        carrying the user's IP and User-Agent to a third party every time a page opened. If these
        ever need to be served remotely, that promise has to be dealt with first.
    -->
    <Border x:Name="Root" Margin="0,0,0,12" Padding="16,12" CornerRadius="10" Cursor="Hand"
            Background="{DynamicResource GlassFillBrush}" BorderThickness="1">
        <Border.BorderBrush>
            <SolidColorBrush Color="{DynamicResource BrandPurpleColor}" Opacity="0.55" />
        </Border.BorderBrush>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Site logo, embedded at build time. Rounded so square and circular marks both sit well. -->
            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8" Margin="0,0,14,0"
                    VerticalAlignment="Center" ClipToBounds="True">
                <Image x:Name="SlotIcon" Stretch="UniformToFill"
                       RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="SlotTitle" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock x:Name="SlotSubtitle" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <ui:Button x:Name="SlotButton" Grid.Column="2" VerticalAlignment="Center" Margin="14,0,0,0"
                       Appearance="Primary" Icon="Open24" Content="Visit"
                       Command="vm:GlobalViewModel.OpenWebpageCommand" />
        </Grid>
    </Border>
</UserControl>
