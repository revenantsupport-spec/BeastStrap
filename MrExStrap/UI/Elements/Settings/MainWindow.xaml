<base:WpfUiWindow x:Class="BeastStrap.UI.Elements.Settings.MainWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pages="clr-namespace:BeastStrap.UI.Elements.Settings.Pages"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:base="clr-namespace:BeastStrap.UI.Elements.Base"
             xmlns:controls="clr-namespace:BeastStrap.UI.Elements.Controls"
             xmlns:resources="clr-namespace:BeastStrap.Resources"
             xmlns:dmodels="clr-namespace:BeastStrap.UI.ViewModels.Settings"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance dmodels:MainWindowViewModel, IsDesignTimeCreatable=True}"
             Title="{x:Static resources:Strings.Menu_Title}"
             MinWidth="1000"
             Width="1000"
             Height="580"
             Background="{ui:ThemeResource ApplicationBackgroundBrush}"
             ExtendsContentIntoTitleBar="True"
             WindowBackdropType="Mica"
             WindowStartupLocation="CenterScreen"
             Closing="WpfUiWindow_Closing"
             Closed="WpfUiWindow_Closed">
    <base:WpfUiWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </base:WpfUiWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- User wallpaper backdrop (collapsed unless the user sets one) -->
        <controls:WallpaperBackground Grid.Row="1" />

        <!-- User animated (GIF) backdrop, layered above the wallpaper (collapsed unless set) -->
        <controls:GifBackground Grid.Row="1" SourcePath="{DynamicResource GifBackgroundPath}" />

        <ui:Snackbar
            x:Name="AlreadyRunningSnackbar"
            Title="{x:Static resources:Strings.Menu_AlreadyRunning_Title}"
            Message="{x:Static resources:Strings.Menu_AlreadyRunning_Caption}"
            Icon="Info20" Timeout="10000" Margin="200,0,200,20" Grid.RowSpan="10" Panel.ZIndex="10" />
        
        <ui:Snackbar
            x:Name="SettingsSavedSnackbar"
            Title="{x:Static resources:Strings.Menu_SettingsSaved_Title}"
            Message="{x:Static resources:Strings.Menu_SettingsSaved_Message}"
            Appearance="Success" Icon="CheckmarkCircle32" Timeout="3000" Margin="200,0,200,20" Grid.RowSpan="10" Panel.ZIndex="9" />

        <ui:TitleBar Padding="8" x:Name="RootTitleBar" Grid.Row="0" ForceShutdown="False" MinimizeToTray="False" UseSnapLayout="True" Title="{x:Static resources:Strings.Menu_Title}" Icon="pack://application:,,,/BeastStrap.ico" />

        <Grid x:Name="RootGrid" Grid.Row="1" Margin="12,12,0,0" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Image Grid.Row="0" Grid.Column="0" Source="pack://application:,,,/Resources/BeastStrap.png"
                   Width="156" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,2,12,14"
                   RenderOptions.BitmapScalingMode="HighQuality" />

            <ui:TextBox x:Name="NavSearchBox" Grid.Row="1" Grid.Column="0" Margin="0,0,12,6" PlaceholderText="Search pages &amp; settings…" Icon="Search24" TextChanged="NavSearchBox_TextChanged" />

            <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="0,0,12,8" VerticalAlignment="Center">
                <TextBlock Text="Simple mode" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" ToolTip="Hide advanced tools to keep nav clean"/>
                <ui:ToggleSwitch IsChecked="{Binding SimpleMode, Mode=TwoWay}" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="Hide Obfuscator / Deobfuscator / Link Bypasser"/>
                <TextBlock Text="hide tools" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Opacity="0.6" VerticalAlignment="Center" Margin="6,0,0,0"/>
            </StackPanel>

            <ui:NavigationFluent x:Name="RootNavigation" Grid.Row="3" Grid.Column="0" Margin="0,0,12,0" Frame="{Binding ElementName=RootFrame}" SelectedPageIndex="0">
                <ui:NavigationFluent.Items>
                    <ui:NavigationItem Content="Home" PageType="{x:Type pages:HomePage}" Icon="Home24" Tag="home" />
                    <ui:NavigationItem Content="News" PageType="{x:Type pages:NewsPage}" Icon="News20" Tag="news" />

                    <ui:NavigationHeader x:Name="PinnedHeader" Text="PINNED" />

                    <ui:NavigationHeader Text="LAUNCH" />
                    <ui:NavigationItem Content="{x:Static resources:Strings.Menu_Behaviour_Title}" PageType="{x:Type pages:BehaviourPage}" Icon="PlaySettings20" Tag="bootstrapper" />
                    <ui:NavigationItem Content="{x:Static resources:Strings.Menu_Integrations_Title}" PageType="{x:Type pages:IntegrationsPage}" Icon="Add28" Tag="integrations" />
                    <ui:NavigationItem Content="{x:Static resources:Strings.Common_Shortcuts}" PageType="{x:Type pages:ShortcutsPage}" Icon="Apps28" Tag="shortcuts" />

                    <ui:NavigationHeader Text="VERSIONS" Visibility="{Binding IsAdvancedMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ui:NavigationItem Content="Versions Manager" PageType="{x:Type pages:VersionsManagerPage}" Icon="Library24" Tag="versionsmanager" Visibility="{Binding IsAdvancedMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ui:NavigationItem Content="Downgrading" PageType="{x:Type pages:VersionPage}" Icon="History24" Tag="downgrading" Visibility="{Binding IsAdvancedMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ui:NavigationItem Content="VIP Servers" PageType="{x:Type pages:VipServerPage}" Icon="People28" Tag="vipservers" Visibility="{Binding IsAdvancedMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ui:NavigationItem Content="Server Browser" PageType="{x:Type pages:ServerBrowserPage}" Icon="Server24" Tag="serverbrowser" Visibility="{Binding IsAdvancedMode, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <ui:NavigationHeader Text="ACCOUNTS" Visibility="{Binding IsAdvancedMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ui:NavigationItem Content="Multi Instance" PageType="{x:Type pages:MultiInstancePage}" Icon="PeopleTeam24" Tag="multiinstance" Visibility="{Binding IsAdvancedMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ui:NavigationItem Content="Accounts Manager" PageType="{x:Type pages:AccountsManagerPage}" Icon="ContactCard24" Tag="accountsmanager" Visibility="{Binding IsAdvancedMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ui:NavigationItem Content="Alt Generator" PageType="{x:Type pages:AltGenPage}" Icon="PersonAdd24" Tag="altgen" Visibility="{Binding IsAdvancedMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ui:NavigationItem Content="BanAsync" PageType="{x:Type pages:BanAsyncPage}" Icon="ShieldKeyhole24" Tag="banasync" Visibility="{Binding IsAdvancedMode, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <ui:NavigationHeader Text="CUSTOMIZATION" />
                    <ui:NavigationItem Content="{x:Static resources:Strings.Menu_Mods_Title}" PageType="{x:Type pages:ModsPage}" Icon="WrenchScrewdriver20" Tag="mods" />
                    <ui:NavigationItem Content="{x:Static resources:Strings.Menu_FastFlags_Title}" PageType="{x:Type pages:FastFlagsPage}" Icon="Flag24" Tag="fastflags" />
                    <ui:NavigationItem Content="Global" PageType="{x:Type pages:GlobalPage}" Icon="Globe24" Tag="global" />
                    <ui:NavigationItem Content="{x:Static resources:Strings.Menu_Appearance_Title}" PageType="{x:Type pages:AppearancePage}" Icon="PaintBrush24" Tag="appearance" />

                    <ui:NavigationHeader Text="TOOLS" Visibility="{Binding IsAdvancedMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ui:NavigationItem Content="Obfuscator" PageType="{x:Type pages:ObfuscatorPage}" Icon="LockClosed24" Tag="obfuscator" Visibility="{Binding IsAdvancedMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ui:NavigationItem Content="Deobfuscator" PageType="{x:Type pages:DeobfuscatorPage}" Icon="LockOpen24" Tag="deobfuscator" Visibility="{Binding IsAdvancedMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ui:NavigationItem Content="Link Bypasser" PageType="{x:Type pages:LinkBypasserPage}" Icon="Link24" Tag="linkbypasser" Visibility="{Binding IsAdvancedMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </ui:NavigationFluent.Items>
                <ui:NavigationFluent.Footer>
                    <ui:NavigationItem Content="Settings" PageType="{x:Type pages:BeastStrapPage}" Icon="Settings24" Tag="shortcuts" />
                    <ui:NavigationItem Content="{x:Static resources:Strings.Menu_About_Title}" Icon="QuestionCircle48" Margin="0,0,0,12" Command="{Binding OpenAboutCommand, Mode=OneTime}" />
                </ui:NavigationFluent.Footer>
            </ui:NavigationFluent>

            <Grid Grid.Row="0" Grid.RowSpan="4" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <ui:Breadcrumb Grid.Row="0" Margin="0,0,0,5" Navigation="{Binding ElementName=RootNavigation}" />
                <Frame x:Name="RootFrame" Grid.Row="1" />
            </Grid>
        </Grid>

        <StatusBar x:Name="RootStatusBar" Grid.Row="2" Padding="14,10" BorderThickness="0,1,0,0"
                   Background="{DynamicResource GlassFillBrush}" BorderBrush="{DynamicResource GlassBorderBrush}"><!-- frosted footer bar -->
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem Grid.Column="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:ToggleSwitch IsChecked="{Binding TestModeEnabled, Mode=TwoWay}" />
                    <TextBlock Padding="12,0,0,0" Text="{x:Static resources:Strings.Menu_TestMode}" VerticalAlignment="Center" FontSize="14" />
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem Grid.Column="2" Padding="0,0,4,0">
                <ui:Button Content="Save and launch Roblox" Appearance="Primary" Icon="Play24" Command="{Binding SaveAndLaunchCommand, Mode=OneWay}" />
            </StatusBarItem>
            <StatusBarItem Grid.Column="3" Padding="4,0,4,0">
                <ui:Button Content="{x:Static resources:Strings.Menu_Save}" Command="{Binding SaveSettingsCommand, Mode=OneWay}" />
            </StatusBarItem>
            <StatusBarItem Grid.Column="4" Padding="4,0,0,0">
                <ui:Button Content="{x:Static resources:Strings.Common_Close}" Command="{Binding CloseWindowCommand, Mode=OneWay}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</base:WpfUiWindow>
