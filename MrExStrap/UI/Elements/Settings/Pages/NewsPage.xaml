<ui:UiPage x:Class="BeastStrap.UI.Elements.Settings.Pages.NewsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:BeastStrap.UI.Elements.Controls"
      xmlns:conv="clr-namespace:BeastStrap.UI.Converters"
      xmlns:models="clr-namespace:BeastStrap.UI.ViewModels.Settings"
      xmlns:vmroot="clr-namespace:BeastStrap.UI.ViewModels"
      d:DataContext="{d:DesignInstance Type=models:NewsViewModel}"
      mc:Ignorable="d"
      d:DesignHeight="620" d:DesignWidth="900"
      Title="NewsPage"
      Scrollable="False">

    <ui:UiPage.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:StringEqualsConverter x:Key="Eq" />

        <!-- Muted tag/chip palette: a faint accent wash + soft accent text, so IMP/FIX badges and the
             selected filter chip read calm against the dark UI instead of glowing neon. -->
        <SolidColorBrush x:Key="ChipCheckedBg" Color="#2838BDF8" />
        <SolidColorBrush x:Key="ChipCheckedBorder" Color="#6638BDF8" />
        <SolidColorBrush x:Key="ImpBadgeBg" Color="#243FCF82" />
        <SolidColorBrush x:Key="ImpBadgeFg" Color="#74D6A0" />
        <SolidColorBrush x:Key="FixBadgeBg" Color="#24B07FEB" />
        <SolidColorBrush x:Key="FixBadgeFg" Color="#BCA2E6" />

        <!-- Pill "chip" filter, driven by a RadioButton so one-of-N select is free. -->
        <Style x:Key="Chip" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="11,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="chip" CornerRadius="10" Padding="{TemplateBinding Padding}"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chip" Property="BorderBrush" Value="{StaticResource ChipCheckedBorder}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="chip" Property="Background" Value="{StaticResource ChipCheckedBg}" />
                                <Setter TargetName="chip" Property="BorderBrush" Value="{StaticResource ChipCheckedBorder}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:UiPage.Resources>

    <Grid Margin="0,0,14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Intro -->
        <TextBlock Grid.Row="0" Margin="2,0,0,10" TextWrapping="Wrap" FontSize="12.5"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}">
            <Run Text="Official Roblox news, pulled live from " /><Run FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="devforum.roblox.com" /><Run Text=" and " /><Run FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="create.roblox.com" /><Run Text=" — no login required." />
        </TextBlock>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============================ LEFT: Announcements ============================ -->
            <Border Grid.Column="0" Margin="0,0,7,0" CornerRadius="8" BorderThickness="1"
                    Background="{DynamicResource GlassFillBrush}" BorderBrush="{DynamicResource GlassBorderBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="14,12,14,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="DevForum Announcements" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="/c/updates/announcements · newest first" FontSize="11"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button Icon="Open24" Content="Source" Padding="9,4" FontSize="12"
                                       Command="vmroot:GlobalViewModel.OpenWebpageCommand"
                                       CommandParameter="{Binding AnnouncementsSourceUrl}" />
                            <ui:Button Icon="ArrowSync24" Content="Refresh" Margin="6,0,0,0" Padding="9,4" FontSize="12"
                                       Command="{Binding RefreshAnnouncementsCommand}" />
                        </StackPanel>
                    </Grid>

                    <!-- Search -->
                    <ui:TextBox Grid.Row="1" Margin="14,0,14,8" Icon="Search24" PlaceholderText="Search announcements…"
                                Text="{Binding AnnouncementSearch, UpdateSourceTrigger=PropertyChanged}" />

                    <!-- List -->
                    <ScrollViewer Grid.Row="2" Margin="6,0,6,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding AnnouncementsView}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="8,4" Padding="12,10" CornerRadius="6" BorderThickness="1"
                                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- Title row (whole row toggles expand) -->
                                            <Grid Grid.Row="0" Background="Transparent" Cursor="Hand">
                                                <Grid.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleCommand}" />
                                                </Grid.InputBindings>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ui:SymbolIcon Grid.Column="0" Symbol="{Binding ChevronSymbol}" FontSize="16"
                                                               Margin="0,0,6,0" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <ui:SymbolIcon Grid.Column="1" Symbol="Pin24" FontSize="14" Margin="0,0,6,0"
                                                               VerticalAlignment="Center" Foreground="{StaticResource BrandGreenBrush}"
                                                               Visibility="{Binding PinnedVisibility}" />
                                                <TextBlock Grid.Column="2" Text="{Binding Title}" FontWeight="SemiBold" FontSize="13.5"
                                                           TextWrapping="Wrap" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                <TextBlock Grid.Column="3" Text="{Binding AgeText}" FontSize="11" Margin="10,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            </Grid>

                                            <!-- Excerpt (clipped when collapsed) -->
                                            <TextBlock Grid.Row="1" Text="{Binding Excerpt}" TextWrapping="Wrap" Margin="30,4,0,0"
                                                       FontSize="12" MaxHeight="{Binding ExcerptMaxHeight}"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                                            <!-- Open full post (expanded only) -->
                                            <ui:Button Grid.Row="2" Margin="30,8,0,0" Padding="8,3" FontSize="11" Icon="Open24"
                                                       Content="Open full post on DevForum"
                                                       Visibility="{Binding ExpandedVisibility}"
                                                       Command="vmroot:GlobalViewModel.OpenWebpageCommand"
                                                       CommandParameter="{Binding Url}" />

                                            <!-- Meta -->
                                            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="30,8,0,0">
                                                <ui:SymbolIcon Symbol="Comment24" FontSize="13" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                <TextBlock Text="{Binding RepliesText}" Margin="4,0,14,0" FontSize="11"
                                                           VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                <ui:SymbolIcon Symbol="Eye24" FontSize="13" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                <TextBlock Text="{Binding ViewsText}" Margin="4,0,14,0" FontSize="11"
                                                           VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                <ui:SymbolIcon Symbol="Heart24" FontSize="13" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                <TextBlock Text="{Binding LikesText}" Margin="4,0,0,0" FontSize="11"
                                                           VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Footer -->
                    <Grid Grid.Row="3" Margin="14,8,14,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding AnnouncementsFooter}" FontSize="11" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <ui:ProgressRing Grid.Column="1" Width="16" Height="16" IsIndeterminate="True"
                                         Visibility="{Binding AnnouncementsLoading, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Grid>
            </Border>

            <!-- ============================ RIGHT: Release Notes ============================ -->
            <Border Grid.Column="1" Margin="7,0,0,0" CornerRadius="8" BorderThickness="1"
                    Background="{DynamicResource GlassFillBrush}" BorderBrush="{DynamicResource GlassBorderBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="14,12,14,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Release Notes" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="Improvements + Fixes per release" FontSize="11"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button Icon="Open24" Content="Source" Padding="9,4" FontSize="12"
                                       Command="vmroot:GlobalViewModel.OpenWebpageCommand"
                                       CommandParameter="{Binding ReleaseDocsUrl}" />
                            <ui:Button Icon="ArrowSync24" Content="Refresh" Margin="6,0,0,0" Padding="9,4" FontSize="12"
                                       Command="{Binding RefreshReleaseNotesCommand}" />
                        </StackPanel>
                    </Grid>

                    <!-- Toolbar: release picker + Forum + Docs -->
                    <Grid Grid.Row="1" Margin="14,0,14,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" MinWidth="135" VerticalAlignment="Center"
                                  ItemsSource="{Binding Releases}" SelectedItem="{Binding SelectedRelease}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StringFormat='Release {0}'}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ui:Button Grid.Column="2" Icon="Chat24" Content="Forum" Padding="9,4" FontSize="12"
                                   Command="vmroot:GlobalViewModel.OpenWebpageCommand"
                                   CommandParameter="{Binding ReleaseForumUrl}" />
                        <ui:Button Grid.Column="3" Icon="Document24" Content="Docs" Margin="6,0,0,0" Padding="9,4" FontSize="12"
                                   Command="vmroot:GlobalViewModel.OpenWebpageCommand"
                                   CommandParameter="{Binding ReleaseDocsUrl}" />
                    </Grid>

                    <!-- Search + summary -->
                    <Grid Grid.Row="2" Margin="14,0,14,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Grid.Column="0" Icon="Search24" PlaceholderText="Search notes…"
                                    Text="{Binding ReleaseNoteSearch, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Column="1" Text="{Binding ReleaseNotesSummary}" Margin="10,0,0,0" VerticalAlignment="Center"
                                   FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </Grid>

                    <!-- Filter chips -->
                    <WrapPanel Grid.Row="3" Margin="14,0,14,6" Orientation="Horizontal">
                        <RadioButton GroupName="type" Style="{StaticResource Chip}" Content="All"
                                     IsChecked="{Binding TypeFilter, Converter={StaticResource Eq}, ConverterParameter=All}" />
                        <RadioButton GroupName="type" Style="{StaticResource Chip}" Content="{Binding ImpCountText}"
                                     IsChecked="{Binding TypeFilter, Converter={StaticResource Eq}, ConverterParameter=Improvements}" />
                        <RadioButton GroupName="type" Style="{StaticResource Chip}" Content="{Binding FixCountText}"
                                     IsChecked="{Binding TypeFilter, Converter={StaticResource Eq}, ConverterParameter=Fixes}" />
                        <Border Width="1" Height="16" Margin="6,0" VerticalAlignment="Center"
                                Background="{DynamicResource ControlStrokeColorDefaultBrush}" />
                        <RadioButton GroupName="status" Style="{StaticResource Chip}" Content="Any"
                                     IsChecked="{Binding StatusFilter, Converter={StaticResource Eq}, ConverterParameter=All}" />
                        <RadioButton GroupName="status" Style="{StaticResource Chip}" Content="{Binding LiveCountText}"
                                     IsChecked="{Binding StatusFilter, Converter={StaticResource Eq}, ConverterParameter=Live}" />
                        <RadioButton GroupName="status" Style="{StaticResource Chip}" Content="{Binding PendCountText}"
                                     IsChecked="{Binding StatusFilter, Converter={StaticResource Eq}, ConverterParameter=Pending}" />
                    </WrapPanel>

                    <!-- Notes list -->
                    <ScrollViewer Grid.Row="4" Margin="6,0,6,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding ReleaseNotesView}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="8,3" Padding="10,8" CornerRadius="6" BorderThickness="1"
                                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Type badge (soft tinted, not a solid neon fill) -->
                                            <Border Grid.Column="0" MinWidth="34" Height="20" CornerRadius="4" Padding="5,0"
                                                    Margin="0,1,10,0" VerticalAlignment="Top">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource ImpBadgeBg}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFix}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource FixBadgeBg}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding TypeBadge}" FontSize="10" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource ImpBadgeFg}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFix}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource FixBadgeFg}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <!-- Note text with inline code -->
                                            <TextBlock Grid.Column="1" controls:InlineMarkup.Markup="{Binding Text}" TextWrapping="Wrap"
                                                       FontSize="12.5" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                                            <!-- Status badge -->
                                            <Border Grid.Column="2" CornerRadius="9" Margin="10,1,0,0" Padding="8,2" VerticalAlignment="Top"
                                                    Visibility="{Binding StatusVisibility}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPending}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="6" Height="6" Margin="0,0,5,0" VerticalAlignment="Center">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsPending}" Value="True">
                                                                        <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock Text="{Binding Status}" FontSize="10.5" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Footer -->
                    <Grid Grid.Row="5" Margin="14,8,14,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding ReleaseNotesFooter}" FontSize="11" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <ui:ProgressRing Grid.Column="1" Width="16" Height="16" IsIndeterminate="True"
                                         Visibility="{Binding ReleaseNotesLoading, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:UiPage>
