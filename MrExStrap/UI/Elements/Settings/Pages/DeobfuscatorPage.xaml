<ui:UiPage x:Class="BeastStrap.UI.Elements.Settings.Pages.DeobfuscatorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
      xmlns:controls="clr-namespace:BeastStrap.UI.Elements.Controls"
      xmlns:models="clr-namespace:BeastStrap.UI.ViewModels.Settings"
      d:DataContext="{d:DesignInstance Type=models:DeobfuscatorViewModel}"
      mc:Ignorable="d"
      d:DesignHeight="560" d:DesignWidth="820"
      Title="DeobfuscatorPage"
      Scrollable="False">

    <ui:UiPage.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="StatusText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter Property="Foreground" Value="#F0A0A0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ui:UiPage.Resources>

    <Grid Margin="0,0,14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Intro -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock FontSize="14" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="Deobfuscate a Lua / Luau script through the LeakD API. Pick the obfuscator it was made with — or hit Auto-detect and let it guess — then Deobfuscate." />
            <TextBlock FontSize="11.5" Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Text="Heads up: your script is uploaded to the third-party LeakD API to be processed." />
        </StackPanel>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Obfuscator" VerticalAlignment="Center" Margin="0,0,8,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <ComboBox Grid.Column="1" MinWidth="160" VerticalAlignment="Center"
                      ItemsSource="{Binding Methods, Mode=OneTime}" SelectedItem="{Binding SelectedMethod, Mode=TwoWay}" />
            <ui:Button Grid.Column="3" Icon="Search24" Content="Auto-detect" Margin="0,0,8,0"
                       Command="{Binding DetectCommand}" IsEnabled="{Binding NotBusy}"
                       ToolTip="Ask the API which obfuscator this script was made with, and pick the matching deobfuscator." />
            <ui:Button Grid.Column="4" Icon="LockOpen24" Content="Deobfuscate" Appearance="Primary"
                       Command="{Binding DeobfuscateCommand}" IsEnabled="{Binding NotBusy}" />
        </Grid>

        <!-- Editors -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Input -->
            <Grid Grid.Column="0" Margin="0,0,6,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Obfuscated script" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <ui:Button Grid.Column="1" Icon="ClipboardPaste24" Content="Paste" Padding="8,3" FontSize="12" Command="{Binding PasteCommand}" />
                    <ui:Button Grid.Column="2" Icon="EraserSmall24" Content="Clear" Padding="8,3" FontSize="12" Margin="6,0,0,0" Command="{Binding ClearCommand}" />
                </Grid>
                <avalonedit:TextEditor Grid.Row="1" Style="{StaticResource NewTextEditor}"
                                       ShowLineNumbers="True" WordWrap="False"
                                       FontFamily="Consolas" FontSize="12.5" MinHeight="240"
                                       controls:CodeEditor.BoundText="{Binding ScriptInput, Mode=TwoWay}" />
            </Grid>

            <!-- Output -->
            <Grid Grid.Column="1" Margin="6,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Deobfuscated" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <ui:ProgressRing Grid.Column="1" Width="16" Height="16" IsIndeterminate="True" VerticalAlignment="Center" Margin="0,0,6,0"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    <ui:Button Grid.Column="2" Icon="Copy24" Content="Copy" Padding="8,3" FontSize="12"
                               Command="{Binding CopyOutputCommand}" IsEnabled="{Binding HasOutput}" />
                </Grid>
                <avalonedit:TextEditor Grid.Row="1" Style="{StaticResource NewTextEditor}"
                                       ShowLineNumbers="True" WordWrap="False" IsReadOnly="True"
                                       FontFamily="Consolas" FontSize="12.5" MinHeight="240"
                                       controls:CodeEditor.BoundText="{Binding Output, Mode=OneWay}" />
            </Grid>
        </Grid>

        <!-- Status -->
        <TextBlock Grid.Row="3" Margin="0,8,0,0" Style="{StaticResource StatusText}" Text="{Binding StatusText}" />
    </Grid>
</ui:UiPage>
