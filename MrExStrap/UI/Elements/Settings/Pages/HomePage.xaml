<ui:UiPage x:Class="BeastStrap.UI.Elements.Settings.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:models="clr-namespace:BeastStrap.UI.ViewModels"
      xmlns:controls="clr-namespace:BeastStrap.UI.Elements.Controls"
      mc:Ignorable="d"
      d:DesignHeight="620" d:DesignWidth="780"
      Title="HomePage"
      Scrollable="True">
    <Grid Margin="0,0,14,14">
        <StackPanel MaxWidth="660" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,28,0,0">

            <!-- Top action row: keeps the executor checker and version history out of the way of the hero banner. -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:Button Grid.Column="0" Padding="14,8" Height="40"
                           Appearance="Secondary" Icon="History32" FontSize="14"
                           Content="Version history"
                           Click="VersionHistoryButton_Click" />
                <ui:Button Grid.Column="2" Padding="14,8" Height="40"
                           Appearance="Secondary" Icon="Flash24" FontSize="14"
                           Content="Executor checker"
                           Click="ExecutorCheckerButton_Click" />
            </Grid>

            <!-- Brand wordmark with neon glow -->
            <Image Source="pack://application:,,,/Resources/BeastStrap.png"
                   Width="380" HorizontalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   Effect="{DynamicResource BrandGlowSoft}"
                   Visibility="{DynamicResource BrandDefaultArtVisibility}" />

            <!--
                Creator theme hero (a YouTuber or a script site). Their banner is shown as-is (it already
                carries their own name and art, so nothing is laid over it), with the "BeastStrap –" line,
                their tagline and a link to their channel or site underneath.
            -->
            <StackPanel Visibility="{DynamicResource BrandCreatorArtVisibility}">
                <Border Width="660" Height="152" CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource GlassBorderBrush}"
                        Effect="{StaticResource CardShadowEffect}">
                    <Border.Background>
                        <ImageBrush ImageSource="{DynamicResource CreatorBannerImage}" Stretch="UniformToFill"
                                    RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border.Background>
                </Border>
                <Grid Margin="6,14,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Grid.Column="0" Width="60" Height="60" StrokeThickness="3" Stroke="{DynamicResource BrandGradientBrush}"
                             Effect="{DynamicResource BrandGlowSoft}">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="{DynamicResource CreatorAvatarImage}" Stretch="UniformToFill"
                                        RenderOptions.BitmapScalingMode="HighQuality" />
                        </Ellipse.Fill>
                    </Ellipse>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="24" FontWeight="Bold">
                            <Run Text="BeastStrap –" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Run Text="{DynamicResource CreatorName}" Foreground="{DynamicResource BrandGradientBrush}" />
                        </TextBlock>
                        <TextBlock Text="{DynamicResource CreatorTagline}" FontSize="13" Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                    <ui:Button Grid.Column="2" VerticalAlignment="Center" Visibility="{DynamicResource CreatorLinkVisibility}"
                               Icon="{DynamicResource CreatorLinkIcon}" Content="{DynamicResource CreatorLinkText}"
                               Command="{Binding DataContext.OpenWebpageCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                               CommandParameter="{DynamicResource CreatorUrl}" />
                </Grid>
            </StackPanel>

            <!-- The standard look's strapline and divider. Hidden under a creator theme: the hero already has its
                 own tagline, and the extra ~55 px pushed "Save and launch Roblox" below the fold. -->
            <TextBlock Text="The Private Roblox BeastStrap For the Gimpys."
                       HorizontalAlignment="Center" Margin="0,10,0,0" FontSize="14"
                       Visibility="{DynamicResource BrandDefaultArtVisibility}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <!-- Gradient divider -->
            <Border Height="3" Width="200" CornerRadius="2" Margin="0,18,0,0"
                    Visibility="{DynamicResource BrandDefaultArtVisibility}"
                    Background="{DynamicResource BrandGradientBrush}" />

            <!--
                Unexplained-crash notice. Collapsed unless there is actually something to say.
            -->
            <Border Margin="0,18,0,0" Padding="14,12" CornerRadius="4"
                    Visibility="{Binding CrashNoticeVisibility}"
                    Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                    BorderBrush="{DynamicResource SystemFillColorCautionBrush}" BorderThickness="0,0,0,2">
                <StackPanel>
                    <TextBlock Text="{Binding CrashNoticeText}" TextWrapping="Wrap" FontSize="13" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <ui:Button Content="Export logs" Icon="ArrowDownload24" Appearance="Primary"
                                   Command="{Binding ExportCrashLogsCommand}" />
                        <ui:Button Content="Dismiss" Margin="8,0,0,0"
                                   Command="{Binding DismissCrashNoticeCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--
                "New: themes": shown until it's dismissed or the Appearance tab has been opened.
            -->
            <Border Margin="0,18,0,0" Padding="14,10" CornerRadius="8" BorderThickness="1"
                    Visibility="{Binding ThemesNoticeVisibility}"
                    Background="{DynamicResource ChipCheckedBg}" BorderBrush="{DynamicResource BrandAccentEdgeBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Grid.Column="0" Symbol="PaintBrush24" FontSize="20" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="13">
                        <Run Text="New: themes." FontWeight="SemiBold" />
                        <Run Text="{Binding ThemesNoticeText, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </TextBlock>
                    <ui:Button Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Appearance="Primary"
                               Icon="PaintBrush24" Content="Open Appearance" Click="OpenAppearance_Click" />
                    <ui:Button Grid.Column="3" Margin="6,0,0,0" VerticalAlignment="Center" Icon="Dismiss24" ToolTip="Dismiss"
                               Command="{Binding DismissThemesNoticeCommand}" />
                </Grid>
            </Border>

            <!-- Status tiles (glass, responsive: wrap on narrow widths) -->
            <WrapPanel HorizontalAlignment="Center" Margin="0,22,0,0">
                <Border Style="{StaticResource HomeTile}" Width="198" MinHeight="80">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <ui:SymbolIcon Symbol="LockClosed24" FontSize="15" VerticalAlignment="Center"
                                           Foreground="{DynamicResource BrandGreenBrush}" />
                            <TextBlock Text="CHANNEL" Style="{StaticResource BrandSectionHeader}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding RobloxVersion}" FontSize="15" FontWeight="SemiBold"
                                   Style="{StaticResource BrandMono}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding RobloxVersion}" />
                        <TextBlock Text="{Binding ChannelStatus}" FontSize="12" Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="{Binding ExecutorMatchText}" FontSize="12" Margin="0,2,0,0"
                                   Foreground="{Binding ExecutorMatchBrush}"
                                   TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasExecutor}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource HomeTile}" Width="198" MinHeight="80">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <ui:SymbolIcon Symbol="Tag24" FontSize="15" VerticalAlignment="Center"
                                           Foreground="{DynamicResource BrandCyanBrush}" />
                            <TextBlock Text="VERSION" Style="{StaticResource BrandSectionHeader}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding Version}" FontSize="18" FontWeight="SemiBold"
                                   Style="{StaticResource BrandMono}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource HomeTile}" Width="198" MinHeight="80">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <ui:SymbolIcon Symbol="Person24" FontSize="15" VerticalAlignment="Center"
                                           Foreground="{DynamicResource BrandPurpleBrush}" />
                            <TextBlock Text="ACTIVE PROFILE" Style="{StaticResource BrandSectionHeader}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding ActiveProfileName}" FontSize="18" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding ExecutorTitle}" FontSize="12" Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasExecutor}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- Primary launch CTA — clean cyan->green gradient (glow removed, glassy look).
                 Reuses the settings window's Save & Launch command. Wired in code-behind via
                 Window.GetWindow: the RelativeSource ancestor binding doesn't resolve reliably
                 inside the WPF-UI navigation frame, so the Home button silently did nothing. -->
            <ui:Button Margin="6,28,6,0" Height="52" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                       Appearance="Primary" Icon="Play24" FontSize="16"
                       Content="Save and launch Roblox"
                       Click="SaveAndLaunchButton_Click" />

            <TextBlock HorizontalAlignment="Center" Margin="0,14,0,0" FontSize="12"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Text="LIVE channel is re-locked on every launch." />
        </StackPanel>
    </Grid>
</ui:UiPage>