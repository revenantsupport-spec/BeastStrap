<ui:UiPage x:Class="BeastStrap.UI.Elements.Settings.Pages.ScriptsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:BeastStrap.UI.Elements.Controls"
      xmlns:conv="clr-namespace:BeastStrap.UI.Converters"
      xmlns:models="clr-namespace:BeastStrap.UI.ViewModels.Settings"
      xmlns:vmroot="clr-namespace:BeastStrap.UI.ViewModels"
      d:DataContext="{d:DesignInstance Type=models:ScriptsViewModel}"
      mc:Ignorable="d"
      d:DesignHeight="620" d:DesignWidth="900"
      Title="ScriptsPage"
      Scrollable="False">

    <Grid Margin="0,0,14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Intro -->
        <TextBlock Grid.Row="0" Margin="0,0,0,10" FontSize="14" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}">
            <Run Text="Search the script catalogue from" />
            <Hyperlink Command="vmroot:GlobalViewModel.OpenWebpageCommand"
                       CommandParameter="https://robloxscripts.com/">robloxscripts.com</Hyperlink><Run Text=", copy one to your clipboard, and star the ones you keep coming back to." />
            <LineBreak />
            <Run Text="Click a script to see everything it does. Copy gives you the loadstring line — paste that straight into your executor." FontSize="12"
                 Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        </TextBlock>

        <!-- Search + sort -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Debounced in the view model: the API allows 60 requests a minute, so a search per
                 keystroke would burn the budget almost immediately. -->
            <ui:TextBox Grid.Column="0" Icon="Search24" PlaceholderText="Search scripts…"
                        IsEnabled="{Binding SearchEnabled}"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

            <ComboBox Grid.Column="1" MinWidth="140" Margin="8,0,0,0" VerticalAlignment="Center"
                      IsEnabled="{Binding SearchEnabled}"
                      ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SortOption}" />

            <ui:Button Grid.Column="2" Margin="8,0,0,0" Icon="ArrowSync24" Content="Refresh"
                       Command="{Binding RefreshCommand}" />
        </Grid>

        <!-- Filter chips + the place pre-filter -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton Style="{StaticResource Chip}" Content="All" GroupName="access"
                             IsEnabled="{Binding SearchEnabled}"
                             IsChecked="{Binding AccessFilter, Converter={StaticResource Eq}, ConverterParameter=All}" />
                <RadioButton Style="{StaticResource Chip}" Content="Free" GroupName="access"
                             IsEnabled="{Binding SearchEnabled}"
                             IsChecked="{Binding AccessFilter, Converter={StaticResource Eq}, ConverterParameter=Free}" />
                <RadioButton Style="{StaticResource Chip}" Content="Key" GroupName="access"
                             IsEnabled="{Binding SearchEnabled}"
                             IsChecked="{Binding AccessFilter, Converter={StaticResource Eq}, ConverterParameter=Key}" />
                <RadioButton Style="{StaticResource Chip}" Content="Paid" GroupName="access"
                             IsEnabled="{Binding SearchEnabled}"
                             IsChecked="{Binding AccessFilter, Converter={StaticResource Eq}, ConverterParameter=Paid}" />
            </StackPanel>

            <!-- The last game played, offered as a one-click filter. The tab always opens on the whole
                 catalogue: applying this on open made it stick on every launch. -->
            <ui:Button Grid.Column="1" Margin="10,0,0,0" Padding="10,3" FontSize="12"
                       HorizontalAlignment="Left" VerticalAlignment="Center" Icon="History24"
                       ToolTip="Only show scripts for the last game you played"
                       Visibility="{Binding PlaceSuggestionVisibility}"
                       Command="{Binding ApplyPlaceSuggestionCommand}">
                <TextBlock Text="{Binding PlaceSuggestionText}" MaxWidth="260" TextTrimming="CharacterEllipsis" />
            </ui:Button>

            <!-- The place filter once it's been applied, with a cross to drop it again. -->
            <Border Grid.Column="1" Margin="10,0,0,0" Padding="10,3" CornerRadius="10"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    Visibility="{Binding PlaceFilterVisibility}"
                    Background="{DynamicResource ChipCheckedBg}" BorderBrush="{DynamicResource ChipCheckedBorder}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding PlaceFilterText}" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <ui:Button Margin="8,0,0,0" Padding="4,0" Icon="Dismiss24" FontSize="10"
                               ToolTip="Show all scripts instead"
                               Command="{Binding ClearPlaceFilterCommand}" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:ToggleSwitch Content="Verified only" Margin="0,0,14,0"
                                 ToolTip="Only scripts from authors robloxscripts.com has verified"
                                 IsEnabled="{Binding SearchEnabled}"
                                 IsChecked="{Binding VerifiedOnly, Mode=TwoWay}" />
                <ui:ToggleSwitch Content="Favourites"
                                 IsChecked="{Binding ShowFavourites, Mode=TwoWay}" />
            </StackPanel>
        </Grid>

        <!-- Results. ItemsControl + row template on purpose: WPF-UI's global ListView style drops
             the GridViewRowPresenter, so ListView+GridView renders ToString(). -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Scripts}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Click the row for the full record: features, tags, versions, key info. -->
                        <Border BorderThickness="0,0,0,1" Padding="14,10" Cursor="Hand"
                                ToolTip="Click for full details"
                                MouseLeftButtonUp="ScriptRow_Click"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" MinWidth="200" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Thumbnail, cached to disk on first load. Roughly one script in
                                     five has no image, so the lettered placeholder underneath is a
                                     normal state rather than a failure.

                                     Sized 16:9 rather than square on purpose: measured across the
                                     cached thumbnails the median aspect is 1.78 and 39 of 76 are
                                     exactly 128x72, so a square tile was cropping the sides off
                                     nearly every one and leaving an unreadable middle sliver. -->
                                <Grid Grid.Column="0" Width="72" Height="40" Margin="0,0,12,0" VerticalAlignment="Top">
                                    <Border CornerRadius="6" Background="{DynamicResource ChipCheckedBg}"
                                            Visibility="{Binding PlaceholderVisibility}">
                                        <TextBlock Text="{Binding PlaceholderGlyph}" FontSize="17" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                    <!-- Painted as a Border background rather than an Image child:
                                         Border.ClipToBounds does NOT clip to CornerRadius in WPF, so
                                         the old markup rendered square-cornered thumbnails next to
                                         rounded placeholders. An ImageBrush respects the radius. -->
                                    <Border CornerRadius="6" Visibility="{Binding ThumbnailVisibility}"
                                            RenderOptions.BitmapScalingMode="HighQuality">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                </Grid>

                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <Border Margin="8,0,0,0" Padding="7,1" CornerRadius="4" VerticalAlignment="Center"
                                                Visibility="{Binding AccessVisibility}"
                                                Background="{DynamicResource ChipCheckedBg}">
                                            <TextBlock Text="{Binding AccessLabel}" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Text="{Binding Description}" FontSize="12" Margin="0,3,0,0"
                                               TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding Game}" FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                                        <!-- Author + the site's verified tick -->
                                        <TextBlock Text="{Binding AuthorText}" FontSize="11" Margin="10,0,0,0"
                                                   Visibility="{Binding AuthorVisibility}"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <ui:SymbolIcon Symbol="CheckmarkCircle16" FontSize="12" Margin="3,0,0,0"
                                                       VerticalAlignment="Center"
                                                       ToolTip="Verified author"
                                                       Visibility="{Binding VerifiedVisibility}"
                                                       Foreground="{DynamicResource ChipCheckedBorder}" />

                                        <TextBlock Text="{Binding StatsText}" FontSize="11" Margin="10,0,0,0"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- The star lives on the row, so no RelativeSource needed. -->
                                    <ui:Button Padding="8,4" ToolTip="{Binding FavouriteTooltip}"
                                               Icon="{Binding FavouriteSymbol}"
                                               Command="{Binding ToggleFavouriteCommand}" />
                                    <ui:Button Margin="6,0,0,0" Padding="10,4" Icon="Copy24" Content="Copy" Appearance="Primary"
                                               Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType={x:Type ui:UiPage}}}"
                                               CommandParameter="{Binding}" />
                                    <ui:Button Margin="6,0,0,0" Padding="8,4" Icon="Open24" ToolTip="Open on robloxscripts.com"
                                               Command="{Binding DataContext.OpenPageCommand, RelativeSource={RelativeSource AncestorType={x:Type ui:UiPage}}}"
                                               CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Status -->
        <Grid Grid.Row="4" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:ProgressRing Grid.Column="0" Width="16" Height="16" Margin="0,0,8,0" IsIndeterminate="True"
                             Visibility="{Binding Loading, Converter={StaticResource BoolToVis}}" />
            <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="12" VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        </Grid>
    </Grid>
</ui:UiPage>
