<ui:UiPage x:Class="BeastStrap.UI.Elements.Settings.Pages.AccountsManagerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:BeastStrap.UI.Elements.Controls"
      xmlns:models="clr-namespace:BeastStrap.UI.ViewModels.Settings"
      xmlns:vmroot="clr-namespace:BeastStrap.UI.ViewModels"
      d:DataContext="{d:DesignInstance Type=models:AccountsManagerViewModel}"
      mc:Ignorable="d"
      d:DesignHeight="700" d:DesignWidth="800"
      Title="AccountsManagerPage"
      Loaded="Page_Loaded"
      Scrollable="True">

    <ui:UiPage.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </ui:UiPage.Resources>

    <StackPanel Margin="0,0,14,14">
        <TextBlock Margin="0,0,0,8" FontSize="14" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="Manage your Roblox accounts and launch one at a time. Each account opens to the Roblox home screen, signed in as that account — on the LIVE channel with your FastFlags and mods." />

        <!-- Safety / ToS note -->
        <Border Margin="0,0,0,4" Padding="12,8" CornerRadius="6"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,2">
            <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="Only add accounts you own. Logins are stored encrypted on this PC (Windows DPAPI) and never leave it. This tab launches a single account at a time; if you want several open at once, use the Multi Instance tab." />
        </Border>

        <!-- Accounts -->
        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding AccountsHeader, Mode=OneWay}" />
            </StackPanel>
            <ui:Button Grid.Column="1" Icon="PersonAdd24" Content="Add account" Appearance="Primary"
                       Command="{Binding AddAccountCommand, Mode=OneTime}" />
        </Grid>

        <TextBlock Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                   Text="No accounts yet. Click Add account to log in with your browser or paste a cookie."
                   Visibility="{Binding HasNoAccounts, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />

        <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding Accounts, Mode=OneWay}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,4,0,0" Padding="10,8" CornerRadius="6"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" Margin="0,0,10,0" ClipToBounds="True"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                <Image Source="{Binding AvatarUrl, Mode=OneWay}" Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayLabel, Mode=OneWay}" FontSize="14"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding UsernameLine, Mode=OneWay}" FontSize="11"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="Version" VerticalAlignment="Center" FontSize="11" Margin="0,0,6,0"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <ComboBox MinWidth="170" FontSize="12" Padding="8,2"
                                              ItemsSource="{Binding DataContext.AvailableProfiles, RelativeSource={RelativeSource AncestorType=ItemsControl}, Mode=OneWay}"
                                              DisplayMemberPath="Name" SelectedValuePath="Id"
                                              SelectedValue="{Binding VersionProfileId, Mode=TwoWay}"
                                              ToolTip="Which Versions Manager profile this account launches with. 'Default' uses your active version." />
                                </StackPanel>
                            </StackPanel>
                            <ui:Button Grid.Column="3" Icon="Play24" Content="Launch" Margin="0,0,8,0"
                                       Command="{Binding DataContext.LaunchAccountCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                       CommandParameter="{Binding}" />
                            <ui:Button Grid.Column="4" Icon="Delete24" Appearance="Danger" ToolTip="Remove account"
                                       Command="{Binding DataContext.RemoveAccountCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                       CommandParameter="{Binding}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Margin="0,12,0,0" Padding="10,6" CornerRadius="4"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,2"
                Visibility="{Binding HasStatus, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
            <TextBlock TextWrapping="Wrap" FontSize="12" Text="{Binding Status, Mode=OneWay}" />
        </Border>

        <TextBlock Margin="0,16,0,0" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap">
            <Run>Single-account management adapted from</Run>
            <Hyperlink Command="vmroot:GlobalViewModel.OpenWebpageCommand"
                       CommandParameter="https://gitlab.com/centerepic/robloxmanager">sasha / centerepic's robloxmanager</Hyperlink>
            <Run>(MIT).</Run>
        </TextBlock>
    </StackPanel>
</ui:UiPage>