<ui:UiPage x:Class="BeastStrap.UI.Elements.Settings.Pages.AppearancePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:models="clr-namespace:BeastStrap.UI.ViewModels"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:BeastStrap.UI.Elements.Controls"
      xmlns:converters="clr-namespace:BeastStrap.UI.Converters"
      xmlns:resources="clr-namespace:BeastStrap.Resources"
      mc:Ignorable="d"
      d:DesignHeight="1100" d:DesignWidth="800"
      Title="AppearancePage"
      Scrollable="True">
    <ui:UiPage.Resources>
        <ItemsPanelTemplate x:Key="CreatorCardsPanel">
            <UniformGrid Columns="3" />
        </ItemsPanelTemplate>

        <!-- Every banner is 1400x322. -->
        <converters:AspectHeightConverter x:Key="BannerStripHeight" Ratio="0.23" Floor="66" />

        <!-- One card per creator theme, shared by the YouTuber and script site groups. -->
        <DataTemplate x:Key="CreatorCardTemplate">
            <Border Margin="0,0,10,10" CornerRadius="12" BorderThickness="1.5"
                    Background="{DynamicResource GlassFillBrush}" BorderBrush="{Binding CardBorder}">
                <!-- Rows, not a StackPanel: the grid makes a row's cards equally tall, and pinning the buttons to
                     the bottom keeps them level when one tagline wraps to two lines and its neighbour's doesn't. -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Their banner. Anchored left, not centred: banners keep their logo in the middle for the Home
                         hero, and a left-anchored crop puts it clear of the avatar that overlaps the strip's left end.
                         It grows with the card, so a wide or maximized window shows the whole banner rather than
                         cutting the top and bottom off its logo. HighQuality scaling: a 1400 px banner squeezed into
                         this strip shimmers with the default. -->
                    <Border Grid.Row="0" CornerRadius="11,11,0,0"
                            Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource BannerStripHeight}}">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding Banner}" Stretch="UniformToFill" AlignmentX="Left"
                                        RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border.Background>
                    </Border>

                    <!-- Avatar or logo badge overlapping the banner, ACTIVE pill on the right -->
                    <Grid Grid.Row="1" Margin="14,-30,14,0">
                        <Ellipse Width="58" Height="58" HorizontalAlignment="Left" StrokeThickness="3" Stroke="{Binding RingBrush}">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Ellipse.Fill>
                        </Ellipse>
                        <Border Style="{StaticResource Pill}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,4"
                                Background="{StaticResource ImpBadgeBg}" Visibility="{Binding ActiveVisibility}">
                            <TextBlock Style="{StaticResource PillText}" Text="ACTIVE" Foreground="{StaticResource ImpBadgeFg}" />
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="2" Margin="14,8,14,0">
                        <TextBlock Text="{Binding Theme.Name}" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Theme.Handle}" FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="{Binding Theme.Tagline}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                        <!-- Their palette -->
                        <ItemsControl ItemsSource="{Binding Swatches}" Margin="0,10,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Ellipse Width="16" Height="16" Margin="0,0,6,0" Fill="{Binding}"
                                             Stroke="{DynamicResource GlassBorderBrush}" StrokeThickness="1" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- One row: Apply, plus an icon-only link to their channel or site. Only some site themes
                         carry a link (see CreatorTheme.Url), and a single row keeps every card's Apply level
                         whether or not the button beside it is there. -->
                    <Grid Grid.Row="3" Margin="14,12,14,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:Button Grid.Column="0" HorizontalAlignment="Stretch" Appearance="Primary" Icon="PaintBrush24" Content="{Binding ApplyText}"
                                   Background="{Binding ApplyBrush}" MouseOverBackground="{Binding ApplyHoverBrush}" PressedBackground="{Binding ApplyBrush}"
                                   Command="{Binding ApplyCommand}" Visibility="{Binding ApplyVisibility}" />
                        <ui:Button Grid.Column="0" HorizontalAlignment="Stretch" Icon="Checkmark24" Content="Applied" IsEnabled="False"
                                   Visibility="{Binding AppliedVisibility}" />
                        <ui:Button Grid.Column="1" Margin="6,0,0,0" Icon="{Binding Theme.LinkIcon}" ToolTip="{Binding Theme.LinkText}"
                                   Command="{Binding LinkCommand}" Visibility="{Binding LinkVisibility}"
                                   VerticalAlignment="Stretch" />
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </ui:UiPage.Resources>

    <StackPanel Margin="0,0,14,14">
        <TextBlock Text="{x:Static resources:Strings.Menu_Appearance_Description}" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" />

        <controls:OptionControl
            Header="{x:Static resources:Strings.Menu_Appearance_Language_Title}"
            Description="{x:Static resources:Strings.Menu_Appearance_Language_Description}">
            <ComboBox Width="200" Padding="10,5,10,5" ItemsSource="{Binding Languages, Mode=OneTime}" Text="{Binding SelectedLanguage, Mode=TwoWay}" />
        </controls:OptionControl>

        <!-- ===== Creator themes ===== -->
        <TextBlock Text="Creator themes" Style="{StaticResource SectionHeaderText}" Margin="0,22,0,0" />
        <TextBlock FontSize="14" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"
                   Text="Turn the whole app into a YouTuber's or a script site's own edition. Their colours everywhere, their avatar or logo on BeastStrap's windows, tray and launcher, and their banner on the Home page." />

        <!-- Only during a seasonal run (420, Halloween, Christmas): it's showing in place of the saved theme, or it was
             turned off for this year and can be turned back on. -->
        <Border Margin="0,10,0,0" Padding="14,10" CornerRadius="8" BorderThickness="1"
                Visibility="{Binding SeasonalNoticeVisibility}"
                Background="{DynamicResource ChipCheckedBg}" BorderBrush="{DynamicResource BrandAccentEdgeBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="13">
                    <Run Text="{Binding SeasonalGreeting, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text="{Binding SeasonalNotice, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </TextBlock>
                <ui:Button Grid.Column="1" Margin="12,0,0,0" Content="{Binding SeasonalButtonText}" Command="{Binding SeasonalButtonCommand}"
                           PreviewMouseDoubleClick="SeasonalButton_PreviewMouseDoubleClick" />
            </Grid>
        </Border>

        <!-- Margin -10 on the right: every card carries a 10px gutter on its right, including the last column,
             which otherwise stopped the grid 10px short of the page's other full-width rows. -->
        <TextBlock Text="YouTubers" Style="{StaticResource SubSectionHeaderText}" Margin="0,12,0,8" />
        <ItemsControl ItemsSource="{Binding YouTuberCards, Mode=OneTime}" Margin="0,0,-10,0"
                      ItemsPanel="{StaticResource CreatorCardsPanel}" ItemTemplate="{StaticResource CreatorCardTemplate}" />

        <TextBlock Text="Script sites" Style="{StaticResource SubSectionHeaderText}" Margin="0,8,0,8" />
        <ItemsControl ItemsSource="{Binding SiteCards, Mode=OneTime}" Margin="0,0,-10,0"
                      ItemsPanel="{StaticResource CreatorCardsPanel}" ItemTemplate="{StaticResource CreatorCardTemplate}" />

        <TextBlock Text="Seasonal" Style="{StaticResource SubSectionHeaderText}" Margin="0,8,0,8" />
        <ItemsControl ItemsSource="{Binding SeasonalCards, Mode=OneTime}" Margin="0,0,-10,0"
                      ItemsPanel="{StaticResource CreatorCardsPanel}" ItemTemplate="{StaticResource CreatorCardTemplate}" />
        <!-- Each seasonal theme's yearly switch, same order as the cards (CreatorTheme.Season holds the words). -->
        <ItemsControl ItemsSource="{Binding SeasonalSwitches, Mode=OneTime}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <controls:OptionControl Header="{Binding Header}" Description="{Binding Description}">
                        <ui:ToggleSwitch IsChecked="{Binding IsOn, Mode=TwoWay}" />
                    </controls:OptionControl>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ui:Button Margin="0,2,0,0" Icon="ArrowReset24" Content="Back to the standard BeastStrap look"
                   Command="{Binding UseStandardLookCommand}" Visibility="{Binding CreatorActiveVisibility}" />

        <!-- ===== Theme ===== -->
        <TextBlock Text="Theme" Style="{StaticResource SectionHeaderText}" Margin="0,22,0,0" />
        <TextBlock Text="Pick a preset or craft your own. Every change previews live." FontSize="14"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />

        <controls:OptionControl Header="Theme preset" Description="A built-in colour scheme. Editing any colour below switches this to Custom.">
            <ComboBox Width="200" Padding="10,5,10,5" ItemsSource="{Binding ThemePresets}" SelectedItem="{Binding SelectedThemePreset, Mode=TwoWay}" />
        </controls:OptionControl>

        <!-- Colours -->
        <TextBlock Text="Colours" Style="{StaticResource SubSectionHeaderText}" Margin="0,16,0,6" />
        <Border CornerRadius="10" Padding="16,12" BorderThickness="1"
                Background="{DynamicResource GlassFillBrush}" BorderBrush="{DynamicResource GlassBorderBrush}">
            <StackPanel>
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Accent" Style="{StaticResource OptionHeaderText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Border Grid.Column="1" Width="48" Height="24" CornerRadius="5" Margin="0,0,12,0"
                            BorderThickness="1" BorderBrush="{DynamicResource GlassBorderBrush}"
                            Background="{Binding AccentSwatch}" />
                    <ui:TextBox Grid.Column="2" Text="{Binding AccentHex, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Gradient end" Style="{StaticResource OptionHeaderText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Border Grid.Column="1" Width="48" Height="24" CornerRadius="5" Margin="0,0,12,0"
                            BorderThickness="1" BorderBrush="{DynamicResource GlassBorderBrush}"
                            Background="{Binding GradientSwatch}" />
                    <ui:TextBox Grid.Column="2" Text="{Binding GradientEndHex, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Purple accent" Style="{StaticResource OptionHeaderText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Border Grid.Column="1" Width="48" Height="24" CornerRadius="5" Margin="0,0,12,0"
                            BorderThickness="1" BorderBrush="{DynamicResource GlassBorderBrush}"
                            Background="{Binding PurpleSwatch}" />
                    <ui:TextBox Grid.Column="2" Text="{Binding PurpleHex, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Background" Style="{StaticResource OptionHeaderText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Border Grid.Column="1" Width="48" Height="24" CornerRadius="5" Margin="0,0,12,0"
                            BorderThickness="1" BorderBrush="{DynamicResource GlassBorderBrush}"
                            Background="{Binding BackgroundSwatch}" />
                    <ui:TextBox Grid.Column="2" Text="{Binding BackgroundHex, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Card surface" Style="{StaticResource OptionHeaderText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Border Grid.Column="1" Width="48" Height="24" CornerRadius="5" Margin="0,0,12,0"
                            BorderThickness="1" BorderBrush="{DynamicResource GlassBorderBrush}"
                            Background="{Binding SurfaceSwatch}" />
                    <ui:TextBox Grid.Column="2" Text="{Binding SurfaceHex, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Effects -->
        <TextBlock Text="Effects" Style="{StaticResource SubSectionHeaderText}" Margin="0,18,0,0" />
        <controls:OptionControl Header="Aurora background" Description="The animated glow behind the launcher and Home dashboard.">
            <ui:ToggleSwitch IsChecked="{Binding EnableAurora, Mode=TwoWay}" />
        </controls:OptionControl>
        <controls:OptionControl Header="Frosted glass" Description="Translucent card surfaces. Turn off for solid cards.">
            <ui:ToggleSwitch IsChecked="{Binding EnableGlass, Mode=TwoWay}" />
        </controls:OptionControl>
        <controls:OptionControl Header="Neon glow" Description="Soft glow on the wordmark and accent edges.">
            <ui:ToggleSwitch IsChecked="{Binding EnableGlow, Mode=TwoWay}" />
        </controls:OptionControl>

        <!-- App icon -->
        <TextBlock Text="App icon" Style="{StaticResource SubSectionHeaderText}" Margin="0,18,0,0" />
        <controls:OptionControl Header="Custom app icon" Description="Swap the icon BeastStrap's windows show in the taskbar and alt-tab, over a creator theme's too. Pick an .ico or image file. Applies to open windows straight away.">
            <StackPanel Orientation="Horizontal">
                <ui:Button Icon="FolderOpen24" Content="Browse" Command="{Binding BrowseAppIconCommand}" />
                <ui:Button Margin="8,0,0,0" Content="Reset" Command="{Binding ClearAppIconCommand}" />
            </StackPanel>
        </controls:OptionControl>
        <TextBlock Margin="6,4,0,0" FontSize="12" TextWrapping="Wrap" FontFamily="Consolas"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding AppIconLocation}" />

        <ui:Button Margin="0,20,0,0" Icon="ArrowReset24" Content="Reset theme to default" Command="{Binding ResetThemeCommand}" />

        <!-- ===== Bootstrapper =====
             The launch dialog, which is a separate surface from the app theme above.
             These bindings existed in AppearanceViewModel the whole time but lost their
             UI when this page was rebuilt for the glass overhaul, so the styles, icons
             and custom themes were all unreachable. -->
        <TextBlock Text="Bootstrapper" Style="{StaticResource SectionHeaderText}" Margin="0,28,0,0" />
        <TextBlock Text="The dialog you see while Roblox downloads and starts. Nothing here affects the app theme above." FontSize="14"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />

        <controls:OptionControl Header="Style" Description="Which launch dialog to show. Pick Custom Dialog to use one of your own themes below.">
            <StackPanel Orientation="Horizontal">
                <ComboBox Width="200" Padding="10,5,10,5" ItemsSource="{Binding Dialogs, Mode=OneTime}" SelectedItem="{Binding Dialog, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ui:Button Margin="8,0,0,0" Icon="Play24" Content="Preview" Command="{Binding PreviewBootstrapperCommand}" />
            </StackPanel>
        </controls:OptionControl>

        <controls:OptionControl Header="Icon" Description="The icon shown on the launch dialog.">
            <!-- Wider than the page's other drop-downs: the default is "BeastStrap (follows theme)". -->
            <ComboBox Width="260" Padding="10,5,10,5" ItemsSource="{Binding Icons, Mode=OneWay}" SelectedValuePath="IconType" SelectedValue="{Binding Icon, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image Height="16" Source="{Binding ImageSource, Mode=OneWay}" RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Grid.Column="1" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" Text="{Binding Path=IconType, Converter={StaticResource EnumNameConverter}}" />
                        </Grid>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </controls:OptionControl>

        <controls:OptionControl Header="Title" Description="Text shown on the launch dialog.">
            <ui:TextBox Width="200" Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </controls:OptionControl>

        <controls:OptionControl Header="Custom icon" Description="Use your own .ico on the launch dialog. Picking one switches the Icon setting above to Custom.">
            <ui:Button Icon="FolderOpen24" Content="Browse" Command="{Binding BrowseCustomIconLocationCommand}" />
        </controls:OptionControl>
        <TextBlock Margin="6,4,0,0" FontSize="12" TextWrapping="Wrap" FontFamily="Consolas"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding CustomIconLocation}" />

        <!-- Opens itself when the Custom Dialog style is selected, since that's the only
             time these matter. Kept as an expander so it isn't noise the rest of the time. -->
        <ui:CardExpander Margin="0,12,0,0" IsExpanded="{Binding CustomThemesExpanded, Mode=OneWay}">
            <ui:CardExpander.Header>
                <StackPanel>
                    <TextBlock FontSize="14" Text="Custom themes" />
                    <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Text="Build your own launch dialog. Only used when the Style above is set to Custom Dialog." />
                </StackPanel>
            </ui:CardExpander.Header>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ListBox Grid.Column="0" Height="220" Margin="0,0,8,0"
                         ItemsSource="{Binding CustomThemes, Mode=OneWay}"
                         SelectedItem="{Binding SelectedCustomTheme, Mode=TwoWay}" />
                <StackPanel Grid.Column="1">
                    <ui:Button Icon="Add24" Content="Add" HorizontalAlignment="Stretch" Command="{Binding AddCustomThemeCommand}" />
                    <ui:Button Margin="0,6,0,0" Icon="PaintBrush24" Content="Edit" HorizontalAlignment="Stretch"
                               Command="{Binding EditCustomThemeCommand}" IsEnabled="{Binding IsCustomThemeSelected}" />
                    <ui:Button Margin="0,6,0,0" Icon="ArrowExportRtl24" Content="Export" HorizontalAlignment="Stretch"
                               Command="{Binding ExportCustomThemeCommand}" IsEnabled="{Binding IsCustomThemeSelected}" />
                    <ui:Button Margin="0,6,0,0" Icon="Delete24" Content="Delete" HorizontalAlignment="Stretch" Appearance="Danger"
                               Command="{Binding DeleteCustomThemeCommand}" IsEnabled="{Binding IsCustomThemeSelected}" />
                    <TextBlock Margin="0,12,0,4" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Rename to" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Grid.Column="0" IsEnabled="{Binding IsCustomThemeSelected}"
                                    Text="{Binding SelectedCustomThemeName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:Button Grid.Column="1" Margin="6,0,0,0" Content="Rename"
                                   Command="{Binding RenameCustomThemeCommand}" IsEnabled="{Binding IsCustomThemeSelected}" />
                    </Grid>
                </StackPanel>
            </Grid>
        </ui:CardExpander>
    </StackPanel>
</ui:UiPage>
