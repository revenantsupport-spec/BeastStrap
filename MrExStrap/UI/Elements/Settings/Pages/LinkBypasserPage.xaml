<ui:UiPage x:Class="BeastStrap.UI.Elements.Settings.Pages.LinkBypasserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:models="clr-namespace:BeastStrap.UI.ViewModels.Settings"
      xmlns:vmroot="clr-namespace:BeastStrap.UI.ViewModels"
      d:DataContext="{d:DesignInstance Type=models:LinkBypasserViewModel}"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="800"
      Title="LinkBypasserPage"
      Scrollable="True">

    <ui:UiPage.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="StatusText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter Property="Foreground" Value="#F0A0A0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ui:UiPage.Resources>

    <StackPanel Margin="0,0,14,14">

        <TextBlock Margin="0,0,0,4" Text="Link Bypasser" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Margin="0,0,0,12" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="Unlock the real destination behind a locked link — Linkvertise, Lootlabs, Work.ink and more — using the bypass.tools API. Paste a link, get the download / destination." />

        <!-- bypass.tools referral plug -->
        <Border Margin="0,0,0,14" Padding="16,14" CornerRadius="8" Cursor="Hand"
                Background="{StaticResource BrandSurfaceBrush}" BorderThickness="1.5"
                BorderBrush="{StaticResource BrandGradientBrush}"
                ToolTip="https://api.bypass.tools/register?ref=BT-E06777">
            <Border.InputBindings>
                <MouseBinding MouseAction="LeftClick" Command="vmroot:GlobalViewModel.OpenWebpageCommand"
                              CommandParameter="https://api.bypass.tools/register?ref=BT-E06777" />
            </Border.InputBindings>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon Grid.Column="0" Symbol="LockOpen24" FontSize="30" VerticalAlignment="Center"
                               Foreground="{StaticResource BrandGreenBrush}" Margin="0,0,14,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Text="Powered by bypass.tools" />
                    <TextBlock FontSize="12.5" Margin="0,4,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="No API key yet? Sign up free and grab one — then paste it below. It only takes a minute." />
                </StackPanel>
                <ui:Button Grid.Column="2" VerticalAlignment="Center" Margin="14,0,0,0" Appearance="Primary"
                           Icon="Open24" Content="Get an API key"
                           Command="vmroot:GlobalViewModel.OpenWebpageCommand"
                           CommandParameter="https://api.bypass.tools/register?ref=BT-E06777" />
            </Grid>
        </Border>

        <!-- API key -->
        <TextBlock Margin="0,0,0,4" Text="Your bypass.tools API key" FontWeight="SemiBold" />
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox Grid.Column="0" Icon="Key24" PlaceholderText="bt_..."
                        Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Column="1" Text="saved to your local settings only" VerticalAlignment="Center" Margin="10,0,0,0"
                       FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        </Grid>

        <!-- Locked link input -->
        <TextBlock Margin="0,0,0,4" Text="Locked link" FontWeight="SemiBold" />
        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox Grid.Column="0" Icon="Link24" PlaceholderText="https://linkvertise.com/…  ·  https://loot-link.com/…"
                        Text="{Binding LinkInput, UpdateSourceTrigger=PropertyChanged}" />
            <ui:Button Grid.Column="1" Margin="8,0,0,0" Icon="ClipboardPaste24" Content="Paste"
                       Command="{Binding PasteCommand}" />
            <ui:Button Grid.Column="2" Margin="8,0,0,0" Appearance="Primary" Icon="LockOpen24" Content="Bypass"
                       Command="{Binding BypassCommand}" IsEnabled="{Binding NotBusy}" />
        </Grid>

        <!-- Busy + status -->
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <ui:ProgressRing Width="16" Height="16" IsIndeterminate="True" VerticalAlignment="Center" Margin="0,0,8,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            <TextBlock Style="{StaticResource StatusText}" Text="{Binding StatusText}" />
        </StackPanel>

        <!-- Result -->
        <StackPanel Margin="0,16,0,0" Visibility="{Binding ResultVisibility}">
            <TextBlock Margin="0,0,0,4" Text="Destination" FontWeight="SemiBold" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox Grid.Column="0" IsReadOnly="True" Text="{Binding ResultUrl, Mode=OneWay}" />
                <ui:Button Grid.Column="1" Margin="8,0,0,0" Icon="Copy24" Content="Copy"
                           Command="{Binding CopyResultCommand}" />
                <ui:Button Grid.Column="2" Margin="8,0,0,0" Appearance="Primary" Icon="Open24" Content="Open"
                           Command="vmroot:GlobalViewModel.OpenWebpageCommand" CommandParameter="{Binding ResultUrl}" />
            </Grid>
        </StackPanel>

    </StackPanel>
</ui:UiPage>
