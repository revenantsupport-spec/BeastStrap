<ui:UiPage x:Class="BeastStrap.UI.Elements.Settings.Pages.ChangelogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:BeastStrap.UI.Elements.Controls"
      xmlns:models="clr-namespace:BeastStrap.UI.ViewModels.Settings"
      xmlns:vmroot="clr-namespace:BeastStrap.UI.ViewModels"
      d:DataContext="{d:DesignInstance Type=models:ChangelogViewModel}"
      mc:Ignorable="d"
      d:DesignHeight="620" d:DesignWidth="900"
      Title="ChangelogPage"
      Scrollable="False">

    <ui:UiPage.Resources>

        <!-- Small status pill on a release header (LATEST / YOU'RE ON THIS / PRE-RELEASE). The
             category badges inside a release use the shared Brand.xaml brushes instead, bound from
             the view model so all five categories share one template. -->
        <Style x:Key="ReleasePill" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ReleasePillText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </ui:UiPage.Resources>

    <Grid Margin="0,0,14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Intro -->
        <TextBlock Grid.Row="0" Margin="2,0,0,10" TextWrapping="Wrap" FontSize="12.5"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}">
            <Run Text="What's changed in BeastStrap, pulled live from " /><Run FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="sirmemegithub.com" /><Run Text=" — newest release first." />
        </TextBlock>

        <Border Grid.Row="1" CornerRadius="8" BorderThickness="1"
                Background="{DynamicResource GlassFillBrush}" BorderBrush="{DynamicResource GlassBorderBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="14,12,14,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Changelog" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{Binding CurrentVersionText}" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Icon="Open24" Content="Source" Padding="9,4" FontSize="12"
                                   Command="vmroot:GlobalViewModel.OpenWebpageCommand"
                                   CommandParameter="{Binding ReleasesUrl}" />
                        <ui:Button Icon="ArrowSync24" Content="Refresh" Margin="6,0,0,0" Padding="9,4" FontSize="12"
                                   Command="{Binding RefreshCommand}" />
                    </StackPanel>
                </Grid>

                <!-- Search -->
                <ui:TextBox Grid.Row="1" Margin="14,0,14,8" Icon="Search24"
                            PlaceholderText="Search every release…"
                            Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />

                <!-- Releases -->
                <ScrollViewer Grid.Row="2" Margin="6,0,6,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ReleasesList" ItemsSource="{Binding ReleasesView}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="8,4" Padding="12,10" CornerRadius="6" BorderThickness="1"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Header row — the whole row toggles the release open, the
                                             same affordance the News page's announcements use. -->
                                        <Grid Grid.Row="0" Background="Transparent" Cursor="Hand">
                                            <Grid.InputBindings>
                                                <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleCommand}" />
                                            </Grid.InputBindings>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <ui:SymbolIcon Grid.Column="0" Symbol="{Binding ChevronSymbol}" FontSize="16"
                                                           Margin="0,0,8,0" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                                            <TextBlock Grid.Column="1" Text="{Binding Version}" FontSize="15" FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                                            <!-- Status pills -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Style="{StaticResource ReleasePill}" Background="{StaticResource ImpBadgeBg}"
                                                        Visibility="{Binding LatestVisibility}">
                                                    <TextBlock Text="LATEST" Style="{StaticResource ReleasePillText}"
                                                               Foreground="{StaticResource ImpBadgeFg}" />
                                                </Border>
                                                <Border Style="{StaticResource ReleasePill}" Background="{DynamicResource ChipCheckedBg}"
                                                        Visibility="{Binding CurrentVisibility}">
                                                    <TextBlock Text="YOU'RE ON THIS" Style="{StaticResource ReleasePillText}"
                                                               Foreground="{DynamicResource BrandCyanBrush}" />
                                                </Border>
                                                <Border Style="{StaticResource ReleasePill}" Background="{StaticResource NoteBadgeBg}"
                                                        Visibility="{Binding PrereleaseVisibility}">
                                                    <TextBlock Text="PRE-RELEASE" Style="{StaticResource ReleasePillText}"
                                                               Foreground="{StaticResource NoteBadgeFg}" />
                                                </Border>
                                            </StackPanel>

                                            <!-- Summary sits in the flexible column so it trims before
                                                 the date does. -->
                                            <TextBlock Grid.Column="3" Text="{Binding Summary}" FontSize="11" Margin="12,0,10,0"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DateText}" FontSize="11"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{Binding AgeText}" FontSize="11" Margin="8,0,0,0"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Body -->
                                        <StackPanel Grid.Row="1" Margin="24,8,0,2" Visibility="{Binding BodyVisibility}">

                                            <ItemsControl ItemsSource="{Binding Sections}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,0,10">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Coloured rail: what ties a run of
                                                                 bullets to its heading once several
                                                                 sections stack up. -->
                                                            <Border Grid.Column="0" Width="2" CornerRadius="1" Margin="0,2,12,2"
                                                                    Opacity="0.5" Background="{Binding RailBrush}" />

                                                            <StackPanel Grid.Column="1">

                                                                <!-- Heading + category badge -->
                                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2"
                                                                            Visibility="{Binding HeaderVisibility}">
                                                                    <Border CornerRadius="4" Padding="6,1" Margin="0,0,8,0"
                                                                            VerticalAlignment="Center"
                                                                            Background="{Binding BadgeBackground}"
                                                                            Visibility="{Binding BadgeVisibility}">
                                                                        <TextBlock Text="{Binding BadgeText}" FontSize="9.5" FontWeight="Bold"
                                                                                   VerticalAlignment="Center"
                                                                                   Foreground="{Binding BadgeForeground}" />
                                                                    </Border>
                                                                    <TextBlock Text="{Binding Heading}" FontSize="13" FontWeight="SemiBold"
                                                                               TextWrapping="Wrap" VerticalAlignment="Center"
                                                                               Visibility="{Binding HeadingTextVisibility}"
                                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                                </StackPanel>

                                                                <!-- Lines -->
                                                                <ItemsControl ItemsSource="{Binding Lines}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Grid Margin="{Binding Margin}">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="Auto" />
                                                                                    <ColumnDefinition Width="*" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <Ellipse Grid.Column="0" Width="4" Height="4" Margin="0,7,8,0"
                                                                                         VerticalAlignment="Top"
                                                                                         Visibility="{Binding BulletVisibility}"
                                                                                         Fill="{DynamicResource TextFillColorTertiaryBrush}" />
                                                                                <TextBlock Grid.Column="1" controls:InlineMarkup.Markup="{Binding Text}"
                                                                                           TextWrapping="Wrap" FontSize="12.5" LineHeight="18"
                                                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                            </Grid>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- A release published with an empty body. Rare, but it
                                                 would otherwise expand to nothing at all. -->
                                            <TextBlock Text="No notes were written for this release."
                                                       FontSize="12" Margin="0,0,0,6"
                                                       Visibility="{Binding EmptyVisibility}"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                                            <ui:Button Icon="Open24" Content="Open this release on the site"
                                                       Padding="8,3" FontSize="11" Margin="0,2,0,0"
                                                       HorizontalAlignment="Left"
                                                       Command="vmroot:GlobalViewModel.OpenWebpageCommand"
                                                       CommandParameter="{Binding Url}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Empty state. Held back while loading so it can't flash before the first fetch
                     lands; the footer carries any error text. -->
                <TextBlock Grid.Row="2" Text="Nothing to show. Try a different search, or hit Refresh."
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasItems, ElementName=ReleasesList}" Value="False" />
                                        <Condition Binding="{Binding NotLoading}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Footer -->
                <Grid Grid.Row="3" Margin="14,8,14,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Footer}" FontSize="11" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <ui:ProgressRing Grid.Column="1" Width="16" Height="16" IsIndeterminate="True"
                                     Visibility="{Binding Loading, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</ui:UiPage>
