<ui:UiPage x:Class="BeastStrap.UI.Elements.Settings.Pages.FastFlagsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:models="clr-namespace:BeastStrap.UI.ViewModels"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:resources="clr-namespace:BeastStrap.Resources"
      xmlns:controls="clr-namespace:BeastStrap.UI.Elements.Controls"
      mc:Ignorable="d"
      d:DesignHeight="1500" d:DesignWidth="800"
      Title="FastFlagsPage"
      Scrollable="True"
      Loaded="Page_Loaded">
    <StackPanel Margin="0,0,14,14">
        <TextBlock Margin="0,0,0,8" Text="{x:Static resources:Strings.Menu_FastFlags_Description}" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <!-- ===== Per-profile selector ===== -->
        <TextBlock Margin="0,8,0,4" Text="Editing flags for" FontWeight="SemiBold" />
        <ComboBox x:Name="ProfileSelector" MinWidth="280" Padding="10,5,10,5"
                  DisplayMemberPath="Name"
                  MaxDropDownHeight="240"
                  SelectionChanged="ProfileSelector_SelectionChanged" />
        <TextBlock Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                   Text="Each Versions Manager profile keeps its own fast flags. The flags shown here belong to the profile selected above; the profile you actually launch is what gets applied to Roblox." />

        <controls:OptionControl Margin="0,16,0,0"
            Header="{x:Static resources:Strings.Menu_FastFlags_ManagerEnabled_Title}"
            Description="{x:Static resources:Strings.Menu_FastFlags_ManagerEnabled_Description}">
            <ui:ToggleSwitch IsChecked="{Binding UseFastFlagManager, Mode=TwoWay}" />
        </controls:OptionControl>

        <!-- ===== Presets ===== -->
        <TextBlock Text="{x:Static resources:Strings.Common_Presets}" FontSize="20" FontWeight="Medium" Margin="0,16,0,0" />

        <TextBlock Text="{x:Static resources:Strings.Menu_FastFlags_Presets_Categories_Rendering}" FontSize="16" FontWeight="Medium" Margin="0,16,0,0" />
        <controls:MarkdownTextBlock MarkdownText="{Binding Source={x:Static resources:Strings.Menu_FastFlags_Presets_D3DExclusiveFullscreenInfo}, Converter={StaticResource StringFormatConverter}, ConverterParameter='https://bloxstraplabs.com/wiki/features/engine-settings/#exclusive-fullscreen'}"  Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <controls:OptionControl
            Header="{x:Static resources:Strings.Menu_FastFlags_Presets_MSAA_Title}">
            <ComboBox Margin="5,0,0,0" Padding="10,5,10,5" Width="200" ItemsSource="{Binding MSAALevels.Keys, Mode=OneTime}" Text="{Binding SelectedMSAALevel, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </controls:OptionControl>

        <controls:OptionControl
            Header="Rendering mode"
            Description="Force the graphics API Roblox renders with. Vulkan or OpenGL can run better on some GPUs — leave it on Automatic if you're not sure. These flags are on Roblox's allowlist.">
            <ComboBox Margin="5,0,0,0" Padding="10,5,10,5" Width="200" ItemsSource="{Binding RenderingModes.Keys, Mode=OneTime}" Text="{Binding SelectedRenderingMode, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </controls:OptionControl>

        <controls:OptionControl
            Header="Gray sky"
            Description="Replaces the sky with a flat gray. A small visibility and performance tweak. Allowlisted.">
            <ui:ToggleSwitch IsChecked="{Binding GraySky, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl
            Header="Remove grass"
            Description="Sets the grass render distance to zero so decorative grass stops drawing. Can help performance and sightlines. Allowlisted.">
            <ui:ToggleSwitch IsChecked="{Binding DisableGrass, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl
            Header="{x:Static resources:Strings.Menu_FastFlags_Presets_FixDisplayScaling_Title}"
            Description="{x:Static resources:Strings.Menu_FastFlags_Presets_FixDisplayScaling_Description}"
            HelpLink="https://bloxstraplabs.com/wiki/features/engine-settings/#preserving-rendering-quality">
            <ui:ToggleSwitch IsChecked="{Binding FixDisplayScaling, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl
            Header="{x:Static resources:Strings.Menu_FastFlags_Presets_TextureQuality_Title}">
            <ComboBox Margin="5,0,0,0" Padding="10,5,10,5" Width="200" ItemsSource="{Binding TextureQualities.Keys, Mode=OneTime}" Text="{Binding SelectedTextureQuality, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </controls:OptionControl>

        <controls:OptionControl
            Header="Max framerate (FPS unlocker)"
            Description="Removes Roblox's 60 FPS cap by setting the DFIntTaskSchedulerTargetFps engine flag before launch — the safe config method Bloxstrap and Fishstrap use, not a memory patcher like rbxfpsunlocker. Pick your monitor's refresh rate or Unlimited. Whether Roblox honours it can change with engine updates.">
            <ComboBox Margin="5,0,0,0" Padding="10,5,10,5" Width="200" ItemsSource="{Binding FramerateLimits.Keys, Mode=OneTime}" Text="{Binding SelectedFramerateLimit, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </controls:OptionControl>

        <controls:OptionControl
            Margin="0,24,0,0"
            Header="{x:Static resources:Strings.Menu_FastFlags_Reset_Title}">
            <ui:ToggleSwitch IsChecked="{Binding ResetConfiguration, Mode=TwoWay}" />
        </controls:OptionControl>

        <!-- ===== Raw editor ===== -->
        <TextBlock Margin="0,28,0,2" Text="{x:Static resources:Strings.Menu_FastFlagEditor_Title}" FontSize="20" FontWeight="Medium" />
        <TextBlock Margin="0,0,0,2" Text="{x:Static resources:Strings.Menu_FastFlagEditor_Description}" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <controls:MarkdownTextBlock TextWrapping="Wrap" FontSize="14" FontWeight="Bold" Margin="0,0,0,12" MarkdownText="{Binding Source={x:Static resources:Strings.Menu_FastFlagEditor_AllowlistInformation}, Converter={StaticResource StringFormatConverter}, ConverterParameter='https://devforum.roblox.com/t/allowlist-for-local-client-configuration-via-fast-flags/3966569'}"  Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <!-- Bordered wrapped panels instead of ui:InfoBar: InfoBar's Message TextBlock
             doesn't wrap, so the long multi-line banner text was clipped on the right
             (user report 2026-06-01). These wrap and grow with the page width. -->
        <Border Margin="0,0,0,8" Padding="12,10" CornerRadius="4"
                Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                BorderBrush="{DynamicResource SystemFillColorCautionBrush}" BorderThickness="0,0,0,2">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Warning24" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Top" />
                <StackPanel MaxWidth="640">
                    <TextBlock FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"
                               Text="{x:Static resources:Strings.Menu_FastFlagEditor_BannerTitle}" />
                    <TextBlock Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{x:Static resources:Strings.Menu_FastFlagEditor_BannerText}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Margin="0,0,0,8" Padding="12,10" CornerRadius="4"
                Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                BorderBrush="{DynamicResource SystemFillColorAttentionBrush}" BorderThickness="0,0,0,2">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Info24" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Top" />
                <StackPanel MaxWidth="640">
                    <TextBlock FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"
                               Text="Will I face consequences for using flags that aren't on the allowlist?" />
                    <TextBlock Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="No. Fast Flags that aren't on Roblox's allowlist are simply ignored. No action is taken against you for trying to set one, it just won't do anything." />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Ban-risk disclaimer (user-requested). Honest framing: the flags that actually work can still
             be treated as a ToS violation if used for advantage. -->
        <Border Margin="0,0,0,8" Padding="12,10" CornerRadius="4"
                Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}"
                BorderBrush="{DynamicResource SystemFillColorCriticalBrush}" BorderThickness="0,0,0,2">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Warning24" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Top" />
                <StackPanel MaxWidth="640">
                    <TextBlock FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"
                               Text="This could get your account punished" />
                    <TextBlock Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Fast Flags are unofficial engineer and debug settings. The allowlisted ones that do take effect can still change how the game looks or plays for you, and using them to gain an unfair advantage (removing textures or obstacles, forcing lighting, faking UI) can be treated as a Terms of Service violation. Roblox can also change which flags it honours, or starts watching, at any time. Use this at your own risk." />
                </StackPanel>
            </StackPanel>
        </Border>

        <Expander Margin="0,0,0,16" Header="What Fast Flags are currently on Roblox's allowlist?">
            <StackPanel Margin="4,8,4,4">
                <StackPanel.Resources>
                    <Style x:Key="FlagChipBorder" TargetType="Border">
                        <Setter Property="CornerRadius" Value="6" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="Padding" Value="9,4" />
                        <Setter Property="Margin" Value="0,0,7,7" />
                    </Style>
                </StackPanel.Resources>

                <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="Roblox re-evaluates this allowlist regularly and can change it at any time without warning. This list being here is no guarantee a flag stays allowed. Anything not on it has no effect on the Roblox player." />

                <!-- Colour key: the prefix tells you the flag's value type. -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="Type key:" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <Border CornerRadius="4" Padding="7,2" Margin="0,0,6,0" BorderThickness="1" Background="#227EDBA6" BorderBrush="#557EDBA6">
                        <TextBlock FontFamily="Consolas" FontSize="10.5"><Run Text="FFlag" FontWeight="Bold" Foreground="#7EDBA6" /><Run Text=" bool" Foreground="{DynamicResource TextFillColorSecondaryBrush}" /></TextBlock>
                    </Border>
                    <Border CornerRadius="4" Padding="7,2" Margin="0,0,6,0" BorderThickness="1" Background="#226FD3E8" BorderBrush="#556FD3E8">
                        <TextBlock FontFamily="Consolas" FontSize="10.5"><Run Text="FInt" FontWeight="Bold" Foreground="#6FD3E8" /><Run Text=" number" Foreground="{DynamicResource TextFillColorSecondaryBrush}" /></TextBlock>
                    </Border>
                    <Border CornerRadius="4" Padding="7,2" BorderThickness="1" Background="#22C2A9EC" BorderBrush="#55C2A9EC">
                        <TextBlock FontFamily="Consolas" FontSize="10.5"><Run Text="FString" FontWeight="Bold" Foreground="#C2A9EC" /><Run Text=" text" Foreground="{DynamicResource TextFillColorSecondaryBrush}" /></TextBlock>
                    </Border>
                </StackPanel>

                <!-- Geometry -->
                <StackPanel Orientation="Horizontal" Margin="0,4,0,6">
                    <Ellipse Width="9" Height="9" Fill="#3FC8E0" VerticalAlignment="Center" />
                    <TextBlock Text="Geometry" FontWeight="SemiBold" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center" />
                    <Border CornerRadius="8" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                        <TextBlock Text="4" FontSize="10.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Border>
                </StackPanel>
                <WrapPanel>
                    <Border Style="{StaticResource FlagChipBorder}" controls:FlagChip.Flag="DFIntCSGLevelOfDetailSwitchingDistance" />
                    <Border Style="{StaticResource FlagChipBorder}" controls:FlagChip.Flag="DFIntCSGLevelOfDetailSwitchingDistanceL12" />
                    <Border Style="{StaticResource FlagChipBorder}" controls:FlagChip.Flag="DFIntCSGLevelOfDetailSwitchingDistanceL23" />
                    <Border Style="{StaticResource FlagChipBorder}" controls:FlagChip.Flag="DFIntCSGLevelOfDetailSwitchingDistanceL34" />
                </WrapPanel>

                <!-- Rendering -->
                <StackPanel Orientation="Horizontal" Margin="0,12,0,6">
                    <Ellipse Width="9" Height="9" Fill="#58D98C" VerticalAlignment="Center" />
                    <TextBlock Text="Rendering" FontWeight="SemiBold" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center" />
                    <Border CornerRadius="8" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                        <TextBlock Text="13" FontSize="10.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Border>
                </StackPanel>
                <WrapPanel>
                    <Border Style="{StaticResource FlagChipBorder}" controls:FlagChip.Flag="FFlagHandleAltEnterFullscreenManually" />
                    <Border Style="{StaticResource FlagChipBorder}" controls:FlagChip.Flag="DFFlagTextureQualityOverrideEnabled" />
                    <Border Style="{StaticResource FlagChipBorder}" controls:FlagChip.Flag="DFIntTextureQualityOverride" />
                    <Border Style="{StaticResource FlagChipBorder}" controls:FlagChip.Flag="FIntDebugForceMSAASamples" />
                    <Border Style="{StaticResource FlagChipBorder}" controls:FlagChip.Flag="DFFlagDisableDPIScale" />
                    <Border Style="{StaticResource FlagChipBorder}" controls:FlagChip.Flag="FFlagDebugGraphicsPreferD3D11" />
                    <Border Style="{StaticResource FlagChipBorder}" controls:FlagChip.Flag="FFlagDebugSkyGray" />
                    <Border Style="{StaticResource FlagChipBorder}" controls:FlagChip.Flag="DFFlagDebugPauseVoxelizer" />
                    <Border Style="{StaticResource FlagChipBorder}" controls:FlagChip.Flag="DFIntDebugFRMQualityLevelOverride" />
                    <Border Style="{StaticResource FlagChipBorder}" controls:FlagChip.Flag="FIntFRMMaxGrassDistance" />
                    <Border Style="{StaticResource FlagChipBorder}" controls:FlagChip.Flag="FIntFRMMinGrassDistance" />
                    <Border Style="{StaticResource FlagChipBorder}" controls:FlagChip.Flag="FFlagDebugGraphicsPreferVulkan" />
                    <Border Style="{StaticResource FlagChipBorder}" controls:FlagChip.Flag="FFlagDebugGraphicsPreferOpenGL" />
                </WrapPanel>

                <!-- User Interface -->
                <StackPanel Orientation="Horizontal" Margin="0,12,0,6">
                    <Ellipse Width="9" Height="9" Fill="#A78BFA" VerticalAlignment="Center" />
                    <TextBlock Text="User Interface" FontWeight="SemiBold" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center" />
                    <Border CornerRadius="8" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                        <TextBlock Text="1" FontSize="10.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Border>
                </StackPanel>
                <WrapPanel>
                    <Border Style="{StaticResource FlagChipBorder}" controls:FlagChip.Flag="FIntGrassMovementReducedMotionFactor" />
                </WrapPanel>
            </StackPanel>
        </Expander>

        <WrapPanel Orientation="Horizontal">
            <ui:Button Icon="Add28" Content="{x:Static resources:Strings.Menu_FastFlagEditor_AddNew}" Click="AddButton_Click" Margin="0,0,12,16" />
            <ui:Button Icon="Delete48" Content="{x:Static resources:Strings.Menu_FastFlagEditor_DeleteSelected}" Click="DeleteButton_Click" Appearance="Danger"  Margin="0,0,12,16">
                <ui:Button.Style>
                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=DataGrid, Path=SelectedItems.Count}" Value="0">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ui:Button.Style>
            </ui:Button>
            <ToggleButton x:Name="TogglePresetsButton"  Content="{x:Static resources:Strings.Menu_FastFlagEditor_ShowPresetFlags}" Click="ToggleButton_Click"  Margin="0,0,12,16" />
            <ui:Button Icon="Search24" Content="Browse flags" Click="BrowseButton_Click" Margin="0,0,12,16" />
            <ui:Button Icon="ArrowExportRtl24" Content="{x:Static resources:Strings.Menu_FastFlagEditor_ExportJson}" Click="ExportJSONButton_Click" Margin="0,0,12,16" />
            <ui:Button Icon="Library28" Content="Fast flag library" Click="LibraryButton_Click" Margin="0,0,12,16" />
        </WrapPanel>

        <ui:TextBox x:Name="SearchTextBox" Margin="0,0,0,16" Icon="Search32" PlaceholderText="{x:Static resources:Strings.Menu_FastFlagEditor_Search}" TextChanged="SearchTextBox_TextChanged" />

        <DataGrid Name="DataGrid" MaxHeight="460" HeadersVisibility="Column" GridLinesVisibility="Horizontal" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CellEditEnding="DataGrid_CellEditEnding" CanUserReorderColumns="False">
            <DataGrid.Style>
                <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                </Style>
            </DataGrid.Style>

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                    <Setter Property="Height" Value="32" />
                    <Setter Property="Padding" Value="8,0,8,0" />
                    <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground">
                                <Setter.Value>
                                    <SolidColorBrush Color="{DynamicResource TextOnAccentFillColorPrimary}" />
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Background">
                                <Setter.Value>
                                    <SolidColorBrush Color="{DynamicResource SystemAccentColorSecondary}" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </Style.Triggers>
                    <Setter Property="Height" Value="32" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Background="{TemplateBinding Background}" Padding="6,0,6,0">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.CellStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Known" Binding="{Binding Name, Converter={StaticResource FlagKnownConverter}}" Width="56" IsReadOnly="True" />
                <DataGridTextColumn Header="{x:Static resources:Strings.Common_Name}" Binding="{Binding Name}" />
                <DataGridTextColumn Header="Tag" Binding="{Binding Name, Converter={StaticResource FlagTagConverter}}" Width="100" IsReadOnly="True" />
                <DataGridTextColumn Header="{x:Static resources:Strings.Common_Value}" Binding="{Binding Value}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </StackPanel>
</ui:UiPage>
